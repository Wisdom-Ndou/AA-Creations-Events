﻿@model WebApplication1.Models.BusinessAnalyticsViewModel

@{
    ViewBag.Title = "Business Analytics";
}

<link rel="stylesheet"
      href="~/Content/AdminDashboard.css" />

<div class="dashboard-container">

    <!-- PAGE HEADER -->
    <div class="page-header">

        <div>
            <h1>Business Analytics</h1>

            <p>
                Overview of business revenue, expenditure and booking performance.
            </p>
        </div>

        <a href="@Url.Action("AdminDashboard", "Cust")"
           class="back-dashboard-btn">
            <span class="back-arrow">←</span>
            <span>Back to Dashboard</span>
        </a>

    </div>


    <!-- FINANCIAL SUMMARY -->
    <section class="analytics-grid">

        <div class="analytics-card">

            <span class="analytics-label">
                Total Revenue
            </span>

            <strong class="analytics-value">
                R @Model.TotalRevenue.ToString("N2")
            </strong>

            <span class="analytics-description">
                Revenue from approved bookings
            </span>

        </div>


        <div class="analytics-card">

            <span class="analytics-label">
                Total Expenditure
            </span>

            <strong class="analytics-value">
                R @Model.TotalExpenditure.ToString("N2")
            </strong>

            <span class="analytics-description">
                Recorded business expenses
            </span>

        </div>


        <div class="analytics-card">

            <span class="analytics-label">
                Net Profit
            </span>

            <strong class="analytics-value">
                R @Model.NetProfit.ToString("N2")
            </strong>

            <span class="analytics-description">
                Revenue minus expenditure
            </span>

        </div>

    </section>


    <!-- BOOKING PERFORMANCE -->
    <section class="analytics-section">

        <div class="dashboard-panel">

            <h2>Booking Performance</h2>

            <div class="performance-grid">

                <div>
                    <span>Total Bookings</span>
                    <strong>@Model.TotalBookings</strong>
                </div>

                <div>
                    <span>Approved</span>
                    <strong>@Model.ApprovedBookings</strong>
                </div>

                <div>
                    <span>Pending</span>
                    <strong>@Model.PendingBookings</strong>
                </div>

                <div>
                    <span>Declined</span>
                    <strong>@Model.DeclinedBookings</strong>
                </div>

                <div>
                    <span>Average Booking</span>
                    <strong>
                        R @Model.AverageBookingValue.ToString("N2")
                    </strong>
                </div>

            </div>

        </div>

    </section>


    <!-- REVENUE BY OCCASION -->
    <section class="analytics-section">

        <div class="dashboard-panel">

            <h2>Revenue by Event Type</h2>

            @if (Model.RevenueByOccasion != null &&
                 Model.RevenueByOccasion.Any())
            {
                <div class="analytics-list">

                    @foreach (var item in Model.RevenueByOccasion)
                    {
                        <div class="analytics-row">

                            <span>
                                @item.Name
                            </span>

                            <strong>
                                R @item.Amount.ToString("N2")
                            </strong>

                        </div>
                    }

                </div>
            }
            else
            {
                <div class="empty-state">

                    <h3>No revenue data</h3>

                    <p>
                        There are currently no approved bookings.
                    </p>

                </div>
            }

        </div>

    </section>


    <!-- RECENT EXPENSES -->
    <section class="analytics-section">

        <div class="dashboard-panel">

            <div class="analytics-heading">

                <div>
                    <h2>Recent Expenses</h2>

                    <p>
                        Latest recorded business expenditure.
                    </p>
                </div>

            </div>


            @if (Model.RecentExpenses != null &&
                 Model.RecentExpenses.Any())
            {
                <div class="table-wrapper">

                    <table class="booking-table">

                        <thead>

                            <tr>
                                <th>Date</th>
                                <th>Description</th>
                                <th>Category</th>
                                <th>Amount</th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var expense in Model.RecentExpenses)
                            {
                                <tr>

                                    <td>
                                        @expense.ExpenseDate.ToString("dd MMM yyyy")
                                    </td>

                                    <td>
                                        @expense.Description
                                    </td>

                                    <td>
                                        @expense.Category
                                    </td>

                                    <td>
                                        R @expense.Amount.ToString("N2")
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="empty-state">

                    <h3>No expenses recorded</h3>

                    <p>
                        Add business expenses to begin tracking expenditure.
                    </p>

                </div>
            }

        </div>

    </section>

</div>