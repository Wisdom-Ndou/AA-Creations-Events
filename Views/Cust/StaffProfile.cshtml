@model WebApplication1.Models.Staff
@{
    ViewBag.Title = "Staff Information";
}
<main style="max-width:900px;margin:40px auto;padding:0 20px;">
    <h1>Staff Information</h1>
    <p>This information is read-only. Staff accounts are managed by administrators.</p>

    <dl>
        <dt>Name</dt>
        <dd>@Model.staff_FName @Model.staff_LName</dd>
        <dt>Email</dt>
        <dd>@Model.staff_Email</dd>
        <dt>Phone</dt>
        <dd>+27 @Model.staff_Phone</dd>
        <dt>Staff Type</dt>
        <dd>@(string.IsNullOrWhiteSpace(Model.staff_Type) ? "Not specified" : Model.staff_Type)</dd>
        <dt>Team / City</dt>
        <dd>@Model.staff_City</dd>
    </dl>

    <p><a href="@Url.Action("StaffDashboard","Cust")">Back to dashboard</a></p>
</main>
