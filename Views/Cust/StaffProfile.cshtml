@model WebApplication1.Models.Staff

@{
    ViewBag.Title = "My Profile";
}

<div class="staff-profile-page">

    <!-- HEADER -->

    <div class="profile-header">

        <div>

            <span class="staff-access">
                Staff Access
            </span>

            <h1>My Profile</h1>

            <p>
                View your staff information and activity overview.
            </p>

        </div>

        <a href="@Url.Action("StaffDashboard", "Cust")"
           class="back-button">
            Back to Dashboard
        </a>

    </div>


    <!-- PROFILE CARD -->

    <section class="profile-card">

        <div class="profile-identity">

            <div class="profile-avatar">
                @Model.staff_FName.Substring(0, 1).ToUpper()
                @Model.staff_LName.Substring(0, 1).ToUpper()
            </div>

            <div>

                <h2>
                    @Model.staff_FName @Model.staff_LName
                </h2>

                <p>
                    @Model.staff_Type
                </p>

                <span>
                    @ViewBag.TeamCity Team
                </span>

            </div>

        </div>


        <div class="profile-details">

            <div class="detail-item">

                <span>First Name</span>

                <strong>
                    @Model.staff_FName
                </strong>

            </div>


            <div class="detail-item">

                <span>Last Name</span>

                <strong>
                    @Model.staff_LName
                </strong>

            </div>


            <div class="detail-item">

                <span>Email Address</span>

                <strong>
                    @Model.staff_Email
                </strong>

            </div>


            <div class="detail-item">

                <span>Phone Number</span>

                <strong>
                    @Model.staff_Phone
                </strong>

            </div>


            <div class="detail-item">

                <span>Staff Team</span>

                <strong>
                    @Model.staff_Type
                </strong>

            </div>


            <div class="detail-item">

                <span>Team City</span>

                <strong>
                    @ViewBag.TeamCity
                </strong>

            </div>

        </div>

    </section>


    <!-- ACTIVITY -->

    <section class="profile-activity">

        <div class="section-heading">

            <h2>Activity Overview</h2>

            <p>
                Your staff activity across the system.
            </p>

        </div>


        <div class="activity-grid">

            <div class="activity-card">

                <span>
                    Total Tasks
                </span>

                <strong>
                    @ViewBag.TotalTasks
                </strong>

            </div>


            <div class="activity-card">

                <span>
                    Completed Tasks
                </span>

                <strong>
                    @ViewBag.CompletedTasks
                </strong>

            </div>


            <div class="activity-card">

                <span>
                    Open Issues
                </span>

                <strong>
                    @ViewBag.OpenComplaints
                </strong>

            </div>


            <div class="activity-card">

                <span>
                    Total Hours
                </span>

                <strong>
                    @Convert.ToDouble(ViewBag.TotalHours).ToString("0.00")
                </strong>

            </div>

        </div>

    </section>

</div>

<style>

    body {
        background: #080808;
    }

    .staff-profile-page {
        max-width: 1100px;
        margin: 40px auto;
        padding: 0 20px 50px;
        color: #fff;
    }

    .profile-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 20px;
        margin-bottom: 30px;
    }

        .profile-header h1 {
            margin: 10px 0 5px;
            font-size: 30px;
        }

        .profile-header p {
            color: #999;
            margin: 0;
        }

    .staff-access {
        display: inline-block;
        background: #ff0066;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700;
    }

    .back-button {
        color: #fff;
        border: 1px solid #444;
        border-radius: 8px;
        padding: 10px 16px;
        text-decoration: none;
    }

        .back-button:hover {
            color: #ff0066;
            border-color: #ff0066;
            text-decoration: none;
        }


    /* PROFILE */

    .profile-card {
        background: #111;
        border: 1px solid #333;
        border-radius: 14px;
        overflow: hidden;
        margin-bottom: 30px;
    }

    .profile-identity {
        padding: 30px;
        display: flex;
        align-items: center;
        gap: 20px;
        border-bottom: 1px solid #333;
    }

    .profile-avatar {
        width: 75px;
        height: 75px;
        border-radius: 50%;
        background: #ff0066;
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 22px;
        font-weight: 800;
    }

    .profile-identity h2 {
        margin: 0 0 5px;
    }

    .profile-identity p {
        color: #aaa;
        margin: 0 0 7px;
    }

    .profile-identity span {
        color: #ff5c9b;
        font-size: 12px;
    }

    .profile-details {
        padding: 25px 30px;
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 25px;
    }

    .detail-item span {
        display: block;
        color: #888;
        font-size: 11px;
        text-transform: uppercase;
        margin-bottom: 6px;
    }

    .detail-item strong {
        color: #eee;
        font-size: 14px;
    }


    /* ACTIVITY */

    .profile-activity {
        background: #111;
        border: 1px solid #333;
        border-radius: 14px;
        padding: 25px;
    }

    .section-heading {
        margin-bottom: 20px;
    }

        .section-heading h2 {
            margin: 0 0 5px;
        }

        .section-heading p {
            margin: 0;
            color: #999;
            font-size: 13px;
        }

    .activity-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 15px;
    }

    .activity-card {
        background: #181818;
        border: 1px solid #333;
        border-radius: 10px;
        padding: 20px;
    }

        .activity-card span {
            display: block;
            color: #999;
            font-size: 12px;
            margin-bottom: 10px;
        }

        .activity-card strong {
            font-size: 24px;
            color: #fff;
        }


    @@media (max-width: 800px) {

        .profile-header {
            flex-direction: column;
        }

        .profile-details {
            grid-template-columns: 1fr;
        }

        .activity-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }


    @@media (max-width: 500px) {

        .activity-grid {
            grid-template-columns: 1fr;
        }

        .profile-identity {
            align-items: flex-start;
        }
    }
</style>