@model WebApplication1.Models.Staff
@{
    ViewBag.Title = "Staff Information";
}
<link rel="stylesheet" href="~/Content/StaffPortal.css" />
<style>
.staff-profile-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.staff-profile-item{padding:16px;border:1px solid var(--staff-border);border-radius:12px;background:var(--staff-panel-soft)}.staff-profile-item span{display:block;color:var(--staff-muted);font-size:.8rem;text-transform:uppercase;letter-spacing:.05em;margin-bottom:5px}.staff-profile-item strong{color:var(--staff-text);font-size:1.02rem}@@media(max-width:650px){.staff-profile-grid{grid-template-columns:1fr}}
</style>
<main class="staff-page">
<header class="staff-hero"><div class="staff-eyebrow">Staff Portal</div><h1>Staff Information</h1><p>Your account details are read-only and are managed by AA Creations administrators.</p></header>
<section class="staff-panel">
<div class="staff-profile-grid">
<div class="staff-profile-item"><span>Name</span><strong>@Model.staff_FName @Model.staff_LName</strong></div>
<div class="staff-profile-item"><span>Email</span><strong>@Model.staff_Email</strong></div>
<div class="staff-profile-item"><span>Phone</span><strong>+27 @Model.staff_Phone</strong></div>
<div class="staff-profile-item"><span>Staff Type</span><strong>@(string.IsNullOrWhiteSpace(Model.staff_Type) ? "Not specified" : Model.staff_Type)</strong></div>
<div class="staff-profile-item"><span>Team / City</span><strong>@Model.staff_City</strong></div>
</div>
<p style="margin-top:20px"><a class="staff-link" href="@Url.Action("StaffDashboard","Cust")">← Back to dashboard</a></p>
</section>
</main>