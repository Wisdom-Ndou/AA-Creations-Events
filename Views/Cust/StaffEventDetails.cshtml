@model WebApplication1.Models.Booking

@{
    ViewBag.Title = "Event Details";
}

<style>

    .event-details-page {
        max-width: 1100px;
        margin: 0 auto;
        padding: 45px 25px 70px;
    }

    /* ==========================================
       HEADER
       ========================================== */

    .details-header {
        margin-bottom: 30px;
    }

    .details-badge {
        display: inline-block;
        padding: 7px 15px;
        border-radius: 20px;
        background: #f4e8e2;
        color: #8a5b4b;
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 15px;
    }

    .details-header h1 {
        margin: 0 0 8px;
        color: #222;
        font-size: 40px;
    }

        .details-header h1 em {
            color: #b27b68;
            font-style: italic;
        }

    .details-header p {
        margin: 0;
        color: #777;
        font-size: 14px;
    }

    /* ==========================================
       NAVIGATION
       ========================================== */

    .details-navigation {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        flex-wrap: wrap;
        margin-bottom: 30px;
    }

    .back-events {
        display: inline-block;
        padding: 11px 18px;
        background: #222;
        color: white;
        border-radius: 7px;
        text-decoration: none;
        font-size: 14px;
        font-weight: 600;
    }

        .back-events:hover {
            background: #444;
            color: white;
            text-decoration: none;
        }

    .staff-team {
        color: #777;
        font-size: 14px;
    }

        .staff-team strong {
            color: #333;
        }

    /* ==========================================
       MAIN EVENT CARD
       ========================================== */

    .event-main-card {
        background: #fff;
        border: 1px solid #eee;
        border-radius: 14px;
        box-shadow: 0 5px 20px rgba(0,0,0,.04);
        overflow: hidden;
    }

    .event-main-header {
        padding: 25px 28px;
        border-bottom: 1px solid #eee;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 20px;
    }

        .event-main-header h2 {
            margin: 0 0 5px;
            font-size: 25px;
            color: #222;
        }

    .booking-id {
        color: #999;
        font-size: 13px;
    }

    .approved-badge {
        background: #e7f6ec;
        color: #237a42;
        border-radius: 20px;
        padding: 7px 13px;
        font-size: 11px;
        font-weight: 700;
    }

    /* ==========================================
       SECTIONS
       ========================================== */

    .details-content {
        padding: 28px;
    }

    .details-section {
        margin-bottom: 35px;
    }

        .details-section:last-child {
            margin-bottom: 0;
        }

        .details-section h3 {
            margin: 0 0 18px;
            color: #333;
            font-size: 17px;
            padding-bottom: 10px;
            border-bottom: 1px solid #eee;
        }

    .details-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 20px 30px;
    }

    .detail-item {
        min-width: 0;
    }

    .detail-label {
        color: #999;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .5px;
        margin-bottom: 5px;
    }

    .detail-value {
        color: #333;
        font-size: 14px;
        word-break: break-word;
    }

    /* ==========================================
       ACTIONS
       ========================================== */

    .details-actions {
        border-top: 1px solid #eee;
        padding: 22px 28px;
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
    }

    .details-action-btn {
        display: inline-block;
        padding: 10px 16px;
        border-radius: 7px;
        text-decoration: none;
        font-size: 13px;
        font-weight: 700;
    }

    .tasks-btn {
        background: #b27b68;
        color: #fff;
    }

        .tasks-btn:hover {
            background: #966452;
            color: #fff;
            text-decoration: none;
        }

    .dashboard-btn {
        background: #f3f3f3;
        color: #444;
    }

        .dashboard-btn:hover {
            background: #e8e8e8;
            color: #222;
            text-decoration: none;
        }

    /* ==========================================
       RESPONSIVE
       ========================================== */

    @@media (max-width: 700px) {

        .details-grid {
            grid-template-columns: 1fr;
        }

        .details-header h1 {
            font-size: 33px;
        }

        .event-main-header {
            flex-direction: column;
        }
    }
</style>


<div class="event-details-page">

    <!-- ==========================================
         HEADER
         ========================================== -->

    <section class="details-header">

        <div class="details-badge">
            Staff Access
        </div>

        <h1>
            Event <em>Details</em>
        </h1>

        <p>
            Information for this approved team event.
        </p>

    </section>


    <!-- ==========================================
         NAVIGATION
         ========================================== -->

    <div class="details-navigation">

        <a href="@Url.Action("StaffEvents", "Cust")"
           class="back-events">
            ← Back to Events
        </a>

        <div class="staff-team">

            <strong>@ViewBag.StaffName</strong>

            @if (ViewBag.TeamCity != null)
            {
                <span> | @ViewBag.TeamCity Team</span>
            }

        </div>

    </div>


    <!-- ==========================================
         EVENT
         ========================================== -->

    <section class="event-main-card">

        <div class="event-main-header">

            <div>

                <h2>
                    @Model.Occasion
                </h2>

                <div class="booking-id">
                    Booking #@Model.BookingId
                </div>

            </div>

            <span class="approved-badge">
                @Model.Status
            </span>

        </div>


        <div class="details-content">

            <!-- ==================================
                 EVENT INFORMATION
                 ================================== -->

            <section class="details-section">

                <h3>Event Information</h3>

                <div class="details-grid">

                    <div class="detail-item">

                        <div class="detail-label">
                            Occasion
                        </div>

                        <div class="detail-value">
                            @Model.Occasion
                        </div>

                    </div>


                    <div class="detail-item">

                        <div class="detail-label">
                            Event Date
                        </div>

                        <div class="detail-value">
                            @Model.EventDate.ToString("dd MMMM yyyy")
                        </div>

                    </div>


                    <div class="detail-item">

                        <div class="detail-label">
                            Event Time
                        </div>

                        <div class="detail-value">

                            @if (!string.IsNullOrWhiteSpace(Model.EventTime))
                            {
                                @Model.EventTime
                            }
                            else
                            {
                                <span>Not specified</span>
                            }

                        </div>

                    </div>


                    <div class="detail-item">

                        <div class="detail-label">
                            Status
                        </div>

                        <div class="detail-value">
                            @Model.Status
                        </div>

                    </div>

                </div>

            </section>


            <!-- ==================================
                 VENUE INFORMATION
                 ================================== -->

            <section class="details-section">

                <h3>Venue Information</h3>

                <div class="details-grid">

                    <div class="detail-item">

                        <div class="detail-label">
                            City
                        </div>

                        <div class="detail-value">
                            @Model.City
                        </div>

                    </div>


                    <div class="detail-item">

                        <div class="detail-label">
                            Address
                        </div>

                        <div class="detail-value">

                            @if (!string.IsNullOrWhiteSpace(Model.Address))
                            {
                                @Model.Address
                            }
                            else
                            {
                                <span>Not specified</span>
                            }

                        </div>

                    </div>

                </div>

            </section>


            <!-- ==================================
                 CUSTOMER INFORMATION
                 ================================== -->

            <section class="details-section">

                <h3>Customer Information</h3>

                <div class="details-grid">

                    <div class="detail-item">

                        <div class="detail-label">
                            First Name
                        </div>

                        <div class="detail-value">
                            @Model.FirstName
                        </div>

                    </div>


                    <div class="detail-item">

                        <div class="detail-label">
                            Last Name
                        </div>

                        <div class="detail-value">
                            @Model.LastName
                        </div>

                    </div>

                </div>

            </section>

        </div>


        <!-- ======================================
             ACTIONS
             ====================================== -->

        <div class="details-actions">

            <a href="@Url.Action("StaffTasks", "Cust")"
               class="details-action-btn tasks-btn">
                View My Tasks
            </a>

            <a href="@Url.Action("StaffDashboard", "Cust")"
               class="details-action-btn dashboard-btn">
                Dashboard
            </a>

        </div>

    </section>

</div>