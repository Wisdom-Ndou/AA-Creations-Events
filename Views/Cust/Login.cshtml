﻿@{
    ViewBag.Title = "Sign In";
}

<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign In | AA Creations &amp; Events</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital@0;1&family=Outfit:wght@400;500;600&display=swap"
          rel="stylesheet" />

    <link rel="stylesheet" href="~/Content/Login Style.css" />
</head>
<body>

    <div class="page">

        <!-- ============ LEFT: BRAND PANEL (hidden on small screens) ============ -->
        <aside class="brand-panel"> ... </aside>

        <!-- ============ RIGHT: FORM PANEL ============ -->
        <main class="form-panel">
            <div class="form-wrap">

                <h2 class="form-title">Sign In</h2>
                <p class="form-subtitle">Welcome back — choose your role to continue</p>

                @if (TempData["LoginSuccess"] != null)
                {
                    <div class="login-success" role="status" aria-live="polite">
                        @TempData["LoginSuccess"]
                    </div>
                }

                @if (TempData["AdminRegistrationMessage"] != null)
                {
                    <div class="login-error" role="status" aria-live="polite">
                        @TempData["AdminRegistrationMessage"]
                    </div>
                }

                <div class="role-switch" role="tablist" aria-label="Select role">
                    <button type="button" class="role-btn active" id="roleCustomerBtn" data-role="customer" role="tab" aria-selected="true">
                        Customer
                    </button>
                    <button type="button" class="role-btn" id="roleAdminBtn" data-role="admin" role="tab" aria-selected="false">
                        Admin
                    </button>
                </div>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="login-error">
                        @Html.ValidationSummary(false, "", new { @class = "text-danger" })
                    </div>
                }

                @* Form: default posts to Login; JS will switch to AdminLogin when role=admin *@
                @using (Html.BeginForm("Login", "Cust", FormMethod.Post, new { id = "loginForm", @data_customer_action = Url.Action("Login", "Cust"), @data_admin_action = Url.Action("Login", "Cust") }))
                {
                    @Html.AntiForgeryToken()

                    <input type="hidden" id="role" name="role" value="customer" />

                    <div class="field">
                        <label for="email">Email Address</label>
                        <input type="email" id="email" name="email" placeholder="you@example.com" required />
                    </div>

                    <div class="field">
                        <label for="password">Password</label>
                        <div class="password-row">
                            <input type="password" id="password" name="password" placeholder="••••••••" required />
                            <button type="button" class="toggle-pass" id="togglePass">Show</button>
                        </div>
                    </div>

                    <div class="forgot-password-row">
                        <a href="@Url.Action("ForgotPassword", "Cust")">Forgot Password?</a>
                    </div>

                    @* Admin-only field (name matches CustController.AdminLogin parameter) *@
                    <div class="field" id="accessCodeField" hidden>
                        <label for="adminAccessCode">Admin Access Code</label>
                        <input type="password" id="adminAccessCode" name="adminAccessCode" placeholder="Enter admin access code" />
                    </div>

                    <div class="options-row">
                        <button type="submit" class="submit-btn" id="submitBtn">Sign In</button>
                    </div>
                }

                <div class="register-row" id="customerRegisterRow">
                    <p>Don't have an account? <a class="register-link" href="@Url.Action("Customerregister", "Cust")">Create Account</a></p>
                </div>

                @if (ViewBag.CanRegisterAdmin == true)
                {
                    <div class="register-row" id="adminRegisterRow" style="display:none">
                        <p>Don't have an admin account? <a class="register-link" href="@Url.Action("Adminregister", "Cust")">Create Admin Account</a></p>
                    </div>
                }

                <div class="register-row staff-login-entry" style="margin-top:18px;opacity:.72;font-size:.9rem;">
                    <p>AA Creations staff? <a class="register-link" href="@Url.Action("StaffLogin", "Cust")">Staff sign in</a></p>
                </div>

                <div class="role-indicator">
                    <span class="indicator-dot" id="indicatorDot"></span>
                    <p id="indicatorText">Signing in as customer</p>
                </div>
            </div>
        </main>
    </div>

    <script>
        (function () {
            const customerBtn = document.getElementById('roleCustomerBtn');
            const adminBtn = document.getElementById('roleAdminBtn');
            const roleInput = document.getElementById('role');
            const form = document.getElementById('loginForm');
            const accessField = document.getElementById('accessCodeField');
            const adminRegister = document.getElementById('adminRegisterRow');
            const customerRegister = document.getElementById('customerRegisterRow');
            const indicatorText = document.getElementById('indicatorText');

            // data attributes set by BeginForm
            const customerAction = form.getAttribute('data-customer-action') || '@Url.Action("Login","Cust")';
            const adminAction = form.getAttribute('data-admin-action') || '@Url.Action("Login","Cust")';

            function setRole(role) {
                if (role === 'admin') {
                    adminBtn.classList.add('active'); customerBtn.classList.remove('active');
                    roleInput.value = 'admin';
                    accessField.hidden = false;
                    accessField.querySelector('input').required = true;
                    adminRegister.style.display = 'block';
                    customerRegister.style.display = 'none';
                    form.action = adminAction;
                    indicatorText.textContent = 'Signing in as admin';
                } else {
                    customerBtn.classList.add('active'); adminBtn.classList.remove('active');
                    roleInput.value = 'customer';
                    accessField.hidden = true;
                    accessField.querySelector('input').required = false;
                    adminRegister.style.display = 'none';
                    customerRegister.style.display = 'block';
                    form.action = customerAction;
                    indicatorText.textContent = 'Signing in as customer';
                }
            }

            customerBtn.addEventListener('click', function () { setRole('customer'); });
            adminBtn.addEventListener('click', function () { setRole('admin'); });

            // initialize
            setRole('customer');
        })();
    </script>

</body>
</html>