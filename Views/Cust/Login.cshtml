﻿@{
    ViewBag.Title = "Sign In";
}

<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign In | AA Creations &amp; Events</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital@0;1&family=Outfit:wght@400;500;600&display=swap"
          rel="stylesheet" />

    <link rel="stylesheet" href="~/Content/Login Style.css" />
</head>
<body>

    <div class="page">

        <!-- ============ LEFT: BRAND PANEL (hidden on small screens) ============ -->
        <aside class="brand-panel"> ... </aside>

        <!-- ============ RIGHT: FORM PANEL ============ -->
        <main class="form-panel">
            <div class="form-wrap">

                <h2 class="form-title">Sign In</h2>
                <p class="form-subtitle">Welcome back — choose your role to continue</p>

                <div class="role-switch" role="tablist" aria-label="Select role">
                    <button type="button" class="role-btn active" id="roleCustomerBtn" data-role="customer" role="tab" aria-selected="true">
                        Customer
                    </button>
                    <button type="button" class="role-btn" id="roleAdminBtn" data-role="admin" role="tab" aria-selected="false">
                        Admin
                    </button>
                </div>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="login-error">
                        @Html.ValidationSummary(false, "", new { @class = "text-danger" })
                    </div>
                }

                @* Both Customer and Admin now use the unified Login action *@
                @using (Html.BeginForm(
                    "Login",
                    "Cust",
                    FormMethod.Post,
                    new { id = "loginForm" }
                ))
                {
                    @Html.AntiForgeryToken()

                    <input type="hidden" id="role" name="role" value="customer" />

                    <div class="field">
                        <label for="email">Email Address</label>
                        <input type="email" id="email" name="email" placeholder="you@example.com" required />
                    </div>

                    <div class="field">
                        <label for="password">Password</label>
                        <div class="password-row">
                            <input type="password" id="password" name="password" placeholder="••••••••" required />
                            <button type="button" class="toggle-pass" id="togglePass">Show</button>
                        </div>
                    </div>

                    <div class="forgot-password-row">
                        <a href="@Url.Action("ForgotPassword", "Cust")">Forgot Password?</a>
                    </div>

                    @* Admin-only field *@
                    <div class="field" id="accessCodeField" hidden>
                        <label for="accessCode">Admin Access Code</label>

                        <input type="password"
                               id="accessCode"
                               name="accessCode"
                               placeholder="Enter admin access code" />
                    </div>

                    <div class="options-row">
                        <button type="submit" class="submit-btn" id="submitBtn">Sign In</button>
                    </div>
                }

                <div class="register-row" id="customerRegisterRow">
                    <p>Don't have an account? <a class="register-link" href="@Url.Action("Customerregister", "Cust")">Create Account</a></p>
                </div>

                <div class="register-row" id="adminRegisterRow" style="display:none">
                    <p>Don't have an admin account? <a class="register-link" href="@Url.Action("Adminregister", "Cust")">Create Admin Account</a></p>
                </div>

                <div class="role-indicator">
                    <span class="indicator-dot" id="indicatorDot"></span>
                    <p id="indicatorText">Signing in as customer</p>
                </div>
            </div>
        </main>
    </div>

    <script>
        (function () {

            const customerBtn =
                document.getElementById('roleCustomerBtn');

            const adminBtn =
                document.getElementById('roleAdminBtn');

            const roleInput =
                document.getElementById('role');

            const accessField =
                document.getElementById('accessCodeField');

            const accessCodeInput =
                document.getElementById('accessCode');

            const adminRegister =
                document.getElementById('adminRegisterRow');

            const customerRegister =
                document.getElementById('customerRegisterRow');

            const indicatorText =
                document.getElementById('indicatorText');


            function setRole(role) {

                if (role === 'admin') {

                    adminBtn.classList.add('active');
                    customerBtn.classList.remove('active');

                    adminBtn.setAttribute(
                        'aria-selected',
                        'true'
                    );

                    customerBtn.setAttribute(
                        'aria-selected',
                        'false'
                    );

                    roleInput.value = 'admin';

                    accessField.hidden = false;

                    accessCodeInput.required = true;

                    adminRegister.style.display = 'block';

                    customerRegister.style.display = 'none';

                    indicatorText.textContent =
                        'Signing in as admin';
                }
                else {

                    customerBtn.classList.add('active');
                    adminBtn.classList.remove('active');

                    customerBtn.setAttribute(
                        'aria-selected',
                        'true'
                    );

                    adminBtn.setAttribute(
                        'aria-selected',
                        'false'
                    );

                    roleInput.value = 'customer';

                    accessField.hidden = true;

                    accessCodeInput.required = false;

                    // Clear the admin code when switching back
                    // to customer login.
                    accessCodeInput.value = '';

                    adminRegister.style.display = 'none';

                    customerRegister.style.display = 'block';

                    indicatorText.textContent =
                        'Signing in as customer';
                }
            }


            customerBtn.addEventListener(
                'click',
                function () {
                    setRole('customer');
                }
            );


            adminBtn.addEventListener(
                'click',
                function () {
                    setRole('admin');
                }
            );


            // Start on customer login
            setRole('customer');

        })();
    </script>

</body>
</html>
