@{
    ViewBag.Title = "Admin Sign In";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Admin Sign In | AA Creations & Events</title>

    <link rel="stylesheet" href="~/Content/Styles.css" />

    <style>
        .admin-login-page {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #0d070d;
            padding: 40px 20px;
        }

        .admin-login-card {
            width: 100%;
            max-width: 520px;
            padding: 50px;
            background: #120a12;
            border: 1px solid #4b1740;
            box-shadow: 0 20px 60px rgba(0,0,0,.4);
        }

        .admin-login-badge {
            display: inline-block;
            padding: 8px 18px;
            border: 1px solid #d4006a;
            border-radius: 30px;
            color: #d4006a;
            text-transform: uppercase;
            letter-spacing: 3px;
            font-size: 12px;
            margin-bottom: 25px;
        }

        .admin-login-title {
            color: #fff;
            font-family: Georgia, serif;
            font-size: 42px;
            margin: 0 0 10px;
        }

            .admin-login-title em {
                color: #d4006a;
                font-style: normal;
            }

        .admin-login-subtitle {
            color: #8f7187;
            margin-bottom: 35px;
        }

        .admin-field {
            margin-bottom: 24px;
        }

            .admin-field label {
                display: block;
                color: #8f7187;
                text-transform: uppercase;
                letter-spacing: 2px;
                font-size: 12px;
                margin-bottom: 10px;
            }

            .admin-field input {
                width: 100%;
                box-sizing: border-box;
                padding: 16px;
                background: #0d070d;
                border: 1px solid #57154a;
                border-radius: 12px;
                color: #fff;
                outline: none;
            }

                .admin-field input:focus {
                    border-color: #d4006a;
                }

        .admin-password-row {
            position: relative;
        }

            .admin-password-row input {
                padding-right: 80px;
            }

        .admin-show-password {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            border: none;
            background: transparent;
            color: #d4006a;
            cursor: pointer;
            text-transform: uppercase;
            font-size: 12px;
        }

        .admin-error {
            color: #ff6b9f;
            margin-bottom: 20px;
        }

        .admin-login-button {
            width: 100%;
            padding: 17px;
            border: none;
            border-radius: 14px;
            background: #d4006a;
            color: white;
            font-size: 16px;
            font-weight: bold;
            text-transform: uppercase;
            letter-spacing: 1px;
            cursor: pointer;
        }

            .admin-login-button:hover {
                background: #b8005b;
            }

        .admin-links {
            text-align: center;
            margin-top: 28px;
            line-height: 2;
            color: #765b70;
        }

            .admin-links a {
                color: #d4006a;
                text-decoration: none;
                font-weight: bold;
            }

                .admin-links a:hover {
                    text-decoration: underline;
                }
    </style>
</head>

<body>

    <div class="admin-login-page">

        <div class="admin-login-card">

            <div class="admin-login-badge">
                Admin Access
            </div>

            <h1 class="admin-login-title">
                Admin <em>Sign In</em>
            </h1>

            <p class="admin-login-subtitle">
                Sign in to access the AA Creations & Events administration portal.
            </p>

            @using (Html.BeginForm("AdminLogin", "Cust", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                if (!ViewData.ModelState.IsValid)
                {
                    @Html.ValidationSummary(
                        true,
                        "",
                        new { @class = "admin-error" }
                    )
                }

                <div class="admin-field">
                    <label for="email">Work Email</label>

                    <input type="email"
                           id="email"
                           name="email"
                           placeholder="admin@aacreations.co.za"
                           required />
                </div>

                <div class="admin-field">
                    <label for="password">Password</label>

                    <div class="admin-password-row">

                        <input type="password"
                               id="password"
                               name="password"
                               placeholder="••••••••"
                               required />

                        <button type="button"
                                class="admin-show-password"
                                id="showPassword">
                            Show
                        </button>

                    </div>
                </div>

                <button type="submit" class="admin-login-button">
                    Sign In
                </button>
            }

            <div class="admin-links">

                <div>
                    Don't have an admin account?
                    @Html.ActionLink(
                        "Register here",
                        "Adminregister",
                        "Cust"
                    )
                </div>

                <div>
                    @Html.ActionLink(
                        "Back to Customer Sign In",
                        "Login",
                        "Cust"
                    )
                </div>

            </div>

        </div>

    </div>

    <script>
        const showPassword =
            document.getElementById("showPassword");

        const password =
            document.getElementById("password");

        showPassword.addEventListener("click", function () {

            if (password.type === "password") {
                password.type = "text";
                showPassword.textContent = "Hide";
            }
            else {
                password.type = "password";
                showPassword.textContent = "Show";
            }

        });
    </script>

</body>
</html>
