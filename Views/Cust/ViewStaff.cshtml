@model IEnumerable<WebApplication1.Models.Staff>

@{
    ViewBag.Title = "View Staff";
}

<link rel="stylesheet"
      href="~/Content/AdminDashboard.css" />

<style>

    .staff-list-page {
        max-width: 1200px;
        margin: 0 auto;
        padding: 40px 20px;
    }

    .staff-list-header {
        margin-bottom: 25px;
    }

        .staff-list-header h1 {
            color: #ffffff;
        }

            .staff-list-header h1 span {
                color: #ff2a6d;
            }

        .staff-list-header p {
            color: #a0a0b0;
        }

    .staff-table-panel {
        background: #111111;
        border: 1px solid #333;
        border-radius: 12px;
        padding: 25px;
        overflow-x: auto;
    }

    .staff-table {
        width: 100%;
        border-collapse: collapse;
    }

        .staff-table th {
            text-align: left;
            padding: 14px;
            color: #ff2a6d;
            border-bottom: 2px solid #ff2a6d;
        }

        .staff-table td {
            padding: 14px;
            color: #ffffff;
            border-bottom: 1px solid #2a2a3a;
        }

        .staff-table tr:hover {
            background: rgba(255, 42, 109, 0.05);
        }

    .team-badge {
        display: inline-block;
        padding: 5px 10px;
        border-radius: 999px;
        border: 1px solid #ff2a6d;
        color: #ff2a6d;
        font-size: 0.8rem;
    }

    .staff-actions {
        margin-top: 20px;
        display: flex;
        gap: 12px;
    }

    .staff-action-btn {
        display: inline-block;
        padding: 10px 18px;
        border-radius: 7px;
        text-decoration: none;
        border: 1px solid #ff2a6d;
        color: #ff2a6d;
    }

        .staff-action-btn:hover {
            background: #ff2a6d;
            color: #ffffff;
        }
</style>


<div class="staff-list-page">

    <div class="staff-list-header">

        <h1>
            Registered <span>Staff</span>
        </h1>

        <p>
            Staff members currently registered on the system.
        </p>

    </div>


    <div class="staff-table-panel">

        @if (Model != null && Model.Any())
        {
            <table class="staff-table">

                <thead>

                    <tr>
                        <th>ID</th>
                        <th>First Name</th>
                        <th>Last Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Team</th>
                    </tr>

                </thead>


                <tbody>

                    @foreach (var staff in Model)
                    {
                        <tr>

                            <td>
                                #@staff.staff_ID
                            </td>

                            <td>
                                @staff.staff_FName
                            </td>

                            <td>
                                @staff.staff_LName
                            </td>

                            <td>
                                @staff.staff_Email
                            </td>

                            <td>
                                @staff.staff_Phone
                            </td>

                            <td>

                                <span class="team-badge">
                                    @staff.staff_Type
                                </span>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>
        }
        else
        {
            <div class="empty-state">

                <h3>
                    No staff members registered
                </h3>

                <p>
                    Use the Register Staff button to add your first staff member.
                </p>

            </div>
        }


        <div class="staff-actions">

            <a href="@Url.Action("RegisterStaff", "Cust")"
               class="staff-action-btn">

                + Register Staff

            </a>


            <a href="@Url.Action("StaffInformation", "Cust")"
               class="staff-action-btn">

                ← Staff Information

            </a>

        </div>

    </div>

</div>