@model IEnumerable<WebApplication1.Models.Booking>

@{
    ViewBag.Title = "Pending Approvals";
}

<link rel="stylesheet"
      href="~/Content/AdminDashboard.css" />

<div class="dashboard-container">

    <div class="page-header">
        <div>
            <h1>Pending Approvals</h1>
            <p>Bookings waiting for admin review.</p>
        </div>

        <a href="@Url.Action("AdminDashboard", "Cust")"
           class="dashboard-link">
             
        </a>
    </div>

    @if (TempData["AdminWarning"] != null)
    {
        <div class="admin-warning-banner" role="alert">
            @TempData["AdminWarning"]
        </div>
    }

    <div class="dashboard-panel">

        @if (Model != null && Model.Any())
        {
            <div class="table-wrapper">

                <table class="booking-table">

                    <thead>
                        <tr>
                            <th>Booking ID</th>
                            <th>Client</th>
                            <th>Occasion</th>
                            <th>Date</th>
                            <th>Time</th>
                            <th>Venue Address</th>
                            <th>City</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var booking in Model)
                        {
                            <tr>

                                <td>
                                    #@booking.BookingId
                                </td>

                                <td>
                                    @booking.FirstName
                                    @booking.LastName
                                </td>

                                <td>
                                    @booking.Occasion
                                </td>

                                <td>
                                    @booking.EventDate.ToString("dd MMM yyyy")
                                </td>

                                <td>
                                    @booking.EventTime
                                </td>

                                <td>
                                    @booking.Address
                                </td>

                                <td>
                                    @booking.City
                                </td>

                                <td class="booking-actions">

                                    <form action="@Url.Action("UpdateBookingStatus", "Cust")"
                                          method="post"
                                          class="pending-booking-action-form"
                                          style="display:inline;">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="bookingId"
                                               value="@booking.BookingId" />

                                        <input type="hidden"
                                               name="status"
                                               value="Approved" />

                                        <button type="submit"
                                                class="approve-btn">
                                            Approve
                                        </button>

                                    </form>

                                    <form action="@Url.Action("UpdateBookingStatus", "Cust")"
                                          method="post"
                                          class="pending-booking-action-form"
                                          style="display:inline;">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="bookingId"
                                               value="@booking.BookingId" />

                                        <input type="hidden"
                                               name="status"
                                               value="Declined" />

                                        <button type="submit"
                                                class="decline-btn">
                                            Decline
                                        </button>

                                    </form>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="empty-state">

                <h3>No pending approvals</h3>

                <p>
                    There are currently no bookings waiting for review.
                </p>

            </div>
        }

    </div>

</div>

<div id="pendingBookingModalBackdrop" class="aa-modal-backdrop" role="presentation">
    <div id="pendingBookingModal" class="aa-modal" role="dialog" aria-modal="true" aria-labelledby="pendingBookingModalTitle">
        <div class="aa-modal-icon" id="pendingBookingModalIcon">!</div>
        <h3 id="pendingBookingModalTitle">Booking update</h3>
        <p id="pendingBookingModalMessage"></p>
        <div class="aa-modal-actions">
            <a href="@Url.Action("StaffManagement","Cust")" class="aa-modal-manage-staff" id="pendingBookingModalManageStaff">Manage Staff</a>
            <button type="button" class="aa-modal-close" id="pendingBookingModalClose">Close</button>
        </div>
    </div>
</div>

<script>
(function () {
    const backdrop = document.getElementById('pendingBookingModalBackdrop');
    const modal = document.getElementById('pendingBookingModal');
    const title = document.getElementById('pendingBookingModalTitle');
    const message = document.getElementById('pendingBookingModalMessage');
    const icon = document.getElementById('pendingBookingModalIcon');
    const closeButton = document.getElementById('pendingBookingModalClose');
    const manageStaff = document.getElementById('pendingBookingModalManageStaff');

    function showModal(type, heading, copy, showManageStaff) {
        modal.className = 'aa-modal ' + type;
        title.textContent = heading;
        message.textContent = copy;
        icon.textContent = type === 'success' ? '✓' : (type === 'warning' ? '!' : '×');
        manageStaff.classList.toggle('is-visible', Boolean(showManageStaff));
        backdrop.classList.add('is-open');
    }

    function closeModal() {
        backdrop.classList.remove('is-open');
    }

    closeButton.addEventListener('click', closeModal);
    backdrop.addEventListener('click', function (event) {
        if (event.target === backdrop) closeModal();
    });

    document.querySelectorAll('.pending-booking-action-form').forEach(function (form) {
        form.addEventListener('submit', async function (event) {
            event.preventDefault();

            const button = form.querySelector('button[type="submit"]');
            if (button) button.disabled = true;

            try {
                const body = new URLSearchParams(new FormData(form));

                const response = await fetch(form.action, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: body.toString()
                });

                const data = await response.json();

                if (!data.success) {
                    const noStaff =
                        data.errorCode === 'NO_AVAILABLE_STAFF' ||
                        data.errorCode === 'NO_REGISTERED_STAFF';

                    const heading =
                        data.errorCode === 'NO_AVAILABLE_STAFF'
                            ? 'No staff currently available'
                            : (data.errorCode === 'NO_REGISTERED_STAFF'
                                ? 'No staff registered for this city'
                                : 'Booking update failed');

                    showModal(
                        noStaff ? 'warning' : 'error',
                        heading,
                        data.message || 'The booking could not be updated.',
                        noStaff
                    );

                    if (button) button.disabled = false;
                    return;
                }

                showModal(
                    'success',
                    'Booking updated',
                    data.message || 'The booking status was updated successfully.',
                    false
                );

                window.setTimeout(function () {
                    window.location.reload();
                }, 900);
            }
            catch (error) {
                if (button) button.disabled = false;

                showModal(
                    'error',
                    'Something went wrong',
                    'We could not update this booking. Please check your connection and try again.',
                    false
                );
            }
        });
    });
})();
</script>
