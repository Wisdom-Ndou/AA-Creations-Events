@{
    ViewBag.Title = "Staff Dashboard";
}

<link rel="stylesheet"
      href="~/Content/AdminDashboard.css" />

<div class="dashboard-container">

    <div class="page-header">

        <div>
            <h1>
                Welcome,
                @ViewBag.StaffFirstName
                @ViewBag.StaffLastName
            </h1>

            <p>
                Staff Dashboard
            </p>
        </div>

        <a href="@Url.Action("StaffLogout", "Cust")"
           class="dashboard-link">
            Sign Out
        </a>

    </div>

    <div class="dashboard-panel">

        <div class="panel-header">
            <h2>Staff Information</h2>
        </div>

        <div class="staff-info-grid">

            <div class="info-card">
                <span class="info-label">First Name</span>
                <strong>
                    @ViewBag.StaffFirstName
                </strong>
            </div>

            <div class="info-card">
                <span class="info-label">Last Name</span>
                <strong>
                    @ViewBag.StaffLastName
                </strong>
            </div>

            <div class="info-card">
                <span class="info-label">Email</span>
                <strong>
                    @ViewBag.StaffEmail
                </strong>
            </div>

            <div class="info-card">
                <span class="info-label">Assigned Team</span>
                <strong>
                    @ViewBag.StaffType
                </strong>
            </div>

        </div>

    </div>


    <div class="dashboard-panel">

        <div class="panel-header">
            <h2>Assigned Jobs</h2>
            <p>
                Bookings assigned to your team will appear here.
            </p>
        </div>

        <div class="empty-state">

            <h3>No jobs yet</h3>

            <p>
                New bookings for your assigned area will appear here.
            </p>

        </div>

    </div>

</div>


<style>

    .staff-info-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        margin-top: 20px;
    }

    .info-card {
        background: #1e1e2e;
        border: 1px solid #333;
        border-radius: 12px;
        padding: 20px;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .info-label {
        color: #a0a0b0;
        font-size: 13px;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .info-card strong {
        color: #ffffff;
        font-size: 16px;
        word-break: break-word;
    }

    @@media (max-width: 900px) {

        .staff-info-grid {
            grid-template-columns: repeat(2, 1fr);
        }

    }

    @@media (max-width: 600px) {

        .staff-info-grid {
            grid-template-columns: 1fr;
        }

    }

</style>