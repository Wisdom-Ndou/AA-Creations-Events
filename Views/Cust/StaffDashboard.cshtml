@using System.Linq
@model WebApplication1.Models.StaffDashboardViewModel
@{
    ViewBag.Title = "Staff Dashboard";
}
<main class="page" style="max-width:1200px;margin:auto;padding:32px 20px;">
    <header>
        <h1>My Dashboard</h1>
        <p>Welcome, @Model.StaffMember.staff_FName. Team: @Model.TeamCity</p>
    </header>

    <section class="stats" style="display:grid;grid-template-columns:repeat(4,1fr);gap:14px;">
        <div><strong>Tasks Due Today</strong><div>@Model.TodayTasks</div></div>
        <div><strong>High Priority</strong><div>@Model.HighPriorityTasks</div></div>
        <div><strong>Events This Week</strong><div>@Model.EventsThisWeek</div></div>
        <div><strong>Open Complaints</strong><div>@Model.OpenComplaints</div></div>
    </section>

    <section style="margin-top:24px;">
        <h2>Tasks Due Today</h2>
        @if (Model.TasksDueToday.Count == 0)
        {
            <p>No pending tasks are due today.</p>
        }
        else
        {
            <table>
                <thead><tr><th>Task</th><th>Event</th><th>Due</th><th>Priority</th></tr></thead>
                <tbody>
                @foreach (var task in Model.TasksDueToday.Take(5))
                {
                    <tr>
                        <td>@task.TaskName</td>
                        <td>@(task.Booking == null ? "General task" : task.Booking.Occasion)</td>
                        <td>@task.DueDate.ToString("dd MMM yyyy")</td>
                        <td>@task.Priority</td>
                    </tr>
                }
                </tbody>
            </table>
        }
        <p><a href="@Url.Action("StaffTasks","Cust")">View all tasks</a></p>
    </section>

    <section style="margin-top:24px;">
        <h2>Assigned Events This Week</h2>
        @if (Model.UpcomingEvents.Count == 0)
        {
            <p>No approved assigned events in the next seven days.</p>
        }
        else
        {
            <table>
                <thead><tr><th>Event</th><th>Date</th><th>Location</th><th>Status</th></tr></thead>
                <tbody>
                @foreach (var item in Model.UpcomingEvents)
                {
                    <tr>
                        <td>@item.Occasion</td>
                        <td>@item.EventDate.ToString("dd MMM yyyy") @item.EventTime</td>
                        <td>@item.Address, @item.City</td>
                        <td>@item.Status</td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </section>

    <section style="margin-top:24px;">
        <h2>Hours Logged</h2>
        <p>@(Model.HoursLogged.HasValue ? Model.HoursLogged.Value.ToString("0.0") + " hours" : "Time logging is not implemented yet.")</p>

        <h2>Announcements</h2>
        <p>@(Model.Announcements.Count == 0 ? "No announcements are available." : "")</p>
        @foreach (var announcement in Model.Announcements)
        {
            <article><strong>@announcement.Title</strong><p>@announcement.Message</p></article>
        }
    </section>
</main>
