@model IEnumerable<WebApplication1.Models.StaffTask>
@{
    ViewBag.Title = "Staff Dashboard";
}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Staff Dashboard</title>
<style>
body{margin:0;background:#111;color:#fff;font-family:Segoe UI,Arial,sans-serif}.page{max-width:1200px;margin:auto;padding:32px 20px}.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.stat,.panel{background:#1b1b1b;border:1px solid #333;border-radius:16px;padding:20px}.number{font-size:2rem;font-weight:800}.muted{color:#aaa}.grid{display:grid;grid-template-columns:2fr 1fr;gap:18px;margin-top:18px}.task{padding:14px 0;border-top:1px solid #333}.links{display:grid;gap:10px}.links a{padding:12px;border:1px solid #444;border-radius:8px;color:#fff;text-decoration:none}.links a:hover{border-color:#ff5f91}.status{display:inline-block;padding:4px 9px;border-radius:999px;border:1px solid #555;font-size:.8rem}a{color:#ff5f91}@media(max-width:800px){.stats,.grid{grid-template-columns:1fr}}
</style>
</head>
<body>
<main class="page">
    <div style="display:flex;justify-content:space-between;align-items:center;gap:20px">
        <div><h1>Staff Dashboard</h1><p class="muted">Welcome, @ViewBag.StaffFirstName.</p></div>
        <a href="@Url.Action("StaffLogout","Cust")">Sign out</a>
    </div>

    <section class="stats">
        <div class="stat"><div class="muted">Pending</div><div class="number">@ViewBag.PendingCount</div></div>
        <div class="stat"><div class="muted">Completed</div><div class="number">@ViewBag.CompletedCount</div></div>
        <div class="stat"><div class="muted">Unable to Complete</div><div class="number">@ViewBag.UnsuccessfulCount</div></div>
    </section>

    <section class="grid">
        <div class="panel">
            <h2>My Tasks</h2>
            @if (!Model.Any())
            {
                <p class="muted">No tasks have been assigned to you.</p>
            }
            else
            {
                foreach (var task in Model)
                {
                    <article class="task">
                        <div style="display:flex;justify-content:space-between;gap:15px">
                            <strong>@task.TaskName</strong>
                            <span class="status">@task.Status</span>
                        </div>
                        <p class="muted">@task.DueDate.ToString("dd MMM yyyy")</p>
                        @if (task.Booking != null)
                        {
                            <p class="muted">@task.Booking.Address, @task.Booking.City</p>
                        }
                    </article>
                }
            }
        </div>

        <div class="panel">
            <h2>Quick Actions</h2>
            <div class="links">
                <a href="@Url.Action("StaffTasks","Cust")">View To-Do List →</a>
                <a href="@Url.Action("StaffComplaints","Cust")">Report Event Issue →</a>
                <a href="@Url.Action("StaffProfile","Cust")">My Profile →</a>
            </div>
        </div>
    </section>
</main>
</body>
</html>