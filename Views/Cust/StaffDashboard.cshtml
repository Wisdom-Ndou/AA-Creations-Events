@{
    ViewBag.Title = "Staff Dashboard";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewBag.Title</title>

    <style>
        body, html {
            background: linear-gradient(135deg, #ff2a6d 0%, #d9005c 100%) !important;
            min-height: 100vh;
            margin: 0;
            font-family: 'Segoe UI', Roboto, Arial, sans-serif;
        }

        .page-head {
            padding: 3rem 2rem;
            text-align: center;
        }

        .page-head h1 {
            font-size: 2.5rem;
            font-weight: 800;
            color: #111 !important;
            margin: 0 0 0.5rem 0;
        }

        .page-head h1 em {
            color: #fff !important;
            font-style: italic;
            text-shadow: 2px 2px 0 #111;
        }

        .page-head p {
            color: #111 !important;
            font-weight: 500;
            margin: 0;
        }

        .badge {
            background: #111;
            color: #ff2a6d;
            padding: 0.3rem 1rem;
            border-radius: 999px;
            font-weight: bold;
            font-size: 0.8rem;
            text-transform: uppercase;
            display: inline-block;
            margin-bottom: 1rem;
        }

        .main {
            max-width: 1200px;
            margin: 0 auto;
            padding: 2rem;
        }

        .stat-row {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1.5rem;
            margin-bottom: 2rem;
        }

        .stat-card {
            background: #111 !important;
            border-radius: 16px;
            padding: 1.5rem;
            border: 1px solid #333;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
            transition: 0.3s;
        }

        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.6);
        }

        .stat-card .label {
            color: #ff2a6d !important;
            font-size: 0.8rem;
            text-transform: uppercase;
            font-weight: bold;
            margin-bottom: 0.5rem;
        }

        .stat-card .value {
            font-size: 2.5rem;
            font-weight: 800;
            color: #fff !important;
            line-height: 1.2;
        }

        .stat-card .delta {
            color: #a0a0b0 !important;
            font-size: 0.8rem;
            margin-top: 0.3rem;
        }

        .stat-card .delta.up {
            color: #4ade80 !important;
        }

        .content-grid {
            display: grid;
            grid-template-columns: 1fr 320px;
            gap: 2rem;
        }

        @@media (max-width: 900px) {
            .content-grid {
                grid-template-columns: 1fr;
            }
        }

        .panel {
            background: #111 !important;
            border-radius: 16px;
            padding: 2rem;
            border: 1px solid #333;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
        }

        .panel-head {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid #333;
            padding-bottom: 1rem;
            margin-bottom: 1.5rem;
        }

        .panel-head h2 {
            color: #fff;
            margin: 0;
            font-size: 1.3rem;
        }

        .panel-head p {
            color: #a0a0b0;
            margin: 0.2rem 0 0 0;
            font-size: 0.85rem;
        }

        .panel-link {
            color: #ff2a6d;
            font-weight: bold;
            text-decoration: none;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th {
            text-align: left;
            padding: 1rem;
            border-bottom: 2px solid #ff2a6d;
            color: #ff2a6d;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        td {
            padding: 1rem;
            border-bottom: 1px solid #2a2a3a;
            color: #fff;
        }

        tbody tr:hover {
            background: rgba(255, 42, 109, 0.05);
        }

        .status {
            padding: 0.3rem 0.8rem;
            border-radius: 999px;
            font-size: 0.75rem;
            font-weight: bold;
        }

        .status.high {
            background: rgba(248, 113, 113, 0.15);
            color: #f87171;
            border: 1px solid #f87171;
        }

        .status.medium {
            background: rgba(250, 204, 21, 0.15);
            color: #facc15;
            border: 1px solid #facc15;
        }

        .status.low {
            background: rgba(74, 222, 128, 0.15);
            color: #4ade80;
            border: 1px solid #4ade80;
        }

        .quick-actions {
            display: flex;
            flex-direction: column;
            gap: 0.8rem;
        }

        .quick-action {
            background: #1a1a24;
            border: 1px solid #333;
            color: #fff;
            padding: 1rem;
            border-radius: 10px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            text-decoration: none;
            transition: 0.3s;
            width: 100%;
            box-sizing: border-box;
            cursor: pointer;
        }

        .quick-action:hover {
            background: #ff2a6d;
            border-color: #ff2a6d;
            color: #fff;
        }

        .quick-action span {
            color: #ff2a6d;
            font-weight: bold;
            font-size: 0.8rem;
        }

        .quick-action:hover span {
            color: #fff;
        }

        .announcement {
            border-left: 3px solid #ff2a6d;
            padding-left: 1rem;
        }

        .announcement-title {
            color: #fff;
            margin: 0;
            font-weight: bold;
        }

        .announcement-text {
            color: #a0a0b0;
            margin: 0;
            font-size: 0.85rem;
        }

        .announcement-list {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }
    </style>
</head>

<body>

    <section class="page-head">
        <div class="badge">Staff Access</div>

        <h1>
            My <em>Dashboard</em>
        </h1>

        <p>
            Welcome back! Here is your overview for today.
        </p>
    </section>

    <main class="main">

        <!-- STATISTICS -->

        <section class="stat-row">

            <div class="stat-card">
                <div class="label">Tasks Due Today</div>
                <div class="value" id="dashboardTaskCount">3</div>
                <div class="delta up">2 High Priority</div>
            </div>

            <div class="stat-card">
                <div class="label">Events This Week</div>
                <div class="value">3</div>
                <div class="delta">Next: Tomorrow 10:00</div>
            </div>

            <div class="stat-card">
                <div class="label">Hours Logged</div>
                <div class="value">32h</div>
                <div class="delta up">↑ On track</div>
            </div>

            <div class="stat-card">
                <div class="label">Open Complaints</div>
                <div class="value">1</div>
                <div class="delta">Assigned to you</div>
            </div>

        </section>


        <!-- MAIN CONTENT -->

        <section class="content-grid">

            <!-- TASKS -->

            <div class="panel">

                <div class="panel-head">

                    <div>
                        <h2>My Tasks Today</h2>
                        <p>Items assigned specifically to you</p>
                    </div>

                    <a href="#" class="panel-link">
                        View All →
                    </a>

                </div>

                <div class="table-wrap">

                    <table>

                        <thead>
                            <tr>
                                <th>Task</th>
                                <th>Event</th>
                                <th>Due Time</th>
                                <th>Priority</th>
                            </tr>
                        </thead>

                        <tbody>

                            <tr>
                                <td>Set up floral arrangements</td>
                                <td>30th Birthday - Sandton</td>
                                <td>09:00 AM</td>
                                <td>
                                    <span class="status high">High</span>
                                </td>
                            </tr>

                            <tr>
                                <td>Confirm catering delivery</td>
                                <td>10th Anniversary - Cape Town</td>
                                <td>11:30 AM</td>
                                <td>
                                    <span class="status medium">Medium</span>
                                </td>
                            </tr>

                            <tr>
                                <td>Prepare guest seating chart</td>
                                <td>Graduation Party - JHB</td>
                                <td>02:00 PM</td>
                                <td>
                                    <span class="status low">Low</span>
                                </td>
                            </tr>

                        </tbody>

                    </table>

                </div>

            </div>


            <!-- RIGHT COLUMN -->

            <div class="stack">

                <!-- ANNOUNCEMENTS -->

                <div class="panel">

                    <div class="panel-head">
                        <h2>Announcements</h2>
                    </div>

                    <div class="announcement-list">

                        <div class="announcement">
                            <p class="announcement-title">
                                Team Meeting
                            </p>

                            <p class="announcement-text">
                                Friday at 14:00 in the main office.
                            </p>
                        </div>

                        <div class="announcement">
                            <p class="announcement-title">
                                New Uniforms
                            </p>

                            <p class="announcement-text">
                                Please collect from HR.
                            </p>
                        </div>

                    </div>

                </div>


                <!-- QUICK ACTIONS -->

                <div class="panel">

                    <div class="panel-head">
                        <h2>Quick Actions</h2>
                    </div>

                    <div class="quick-actions">

                        <!-- To-Do List -->

                        <a href="@Url.Action("StaffTasks", "Cust")"
                           class="quick-action">

                            <div>
                                <strong>View To-Do List</strong>

                                <span id="dashboardPendingCount">
                                    3 pending
                                </span>
                            </div>

                            <span>→</span>

                        </a>


                        <!-- Complaints -->

                        <a href="@Url.Action("StaffComplaints", "Cust")"
                           class="quick-action">

                            <div>
                                <strong>Report Event Issue</strong>

                                <span>
                                    Report an issue with an event
                                </span>
                            </div>

                            <span>→</span>

                        </a>

                        <a href="@Url.Action("StaffProfile", "Cust")"
                           class="quick-action">

                            <div>
                                <strong>My Profile</strong>

                                <span>
                                    View account information
                                </span>
                            </div>

                            <span>→</span>

                        </a>


                        <!-- Clock In / Out -->

                        <button type="button"
                                class="quick-action">

                            <div>
                                <strong>Clock In / Out</strong>

                                <span>
                                    Time tracking
                                </span>
                            </div>

                            <span>→</span>

                        </button>

                    </div>

                </div>

            </div>

        </section>

    </main>

</body>
</html>