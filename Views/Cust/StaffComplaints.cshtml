@model IEnumerable<WebApplication1.Models.StaffComplaint>
@{
    ViewBag.Title = "Staff Complaints";
    var staffTasks = ViewBag.StaffTasks as IEnumerable<WebApplication1.Models.StaffTask>;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Staff Complaints</title>
    <style>
        body{margin:0;background:#111;color:#fff;font-family:Segoe UI,Arial,sans-serif}.page{max-width:1100px;margin:auto;padding:32px 20px}.grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}.card{background:#1b1b1b;border:1px solid #333;border-radius:16px;padding:20px}label{display:block;margin:12px 0 6px}input,textarea,select{width:100%;box-sizing:border-box;padding:10px;border-radius:7px;border:1px solid #444;background:#111;color:#fff}textarea{min-height:120px}button{margin-top:14px;padding:11px 16px;border:0;border-radius:7px;background:#ff5f91;color:#111;font-weight:700;cursor:pointer}.complaint{border-top:1px solid #333;padding:14px 0}.muted{color:#aaa}.alert{padding:12px;border-radius:8px;margin-bottom:16px;background:#241f12;color:#ffd86b}.success{background:#142519;color:#80e59a}a{color:#ff5f91;text-decoration:none}@media(max-width:800px){.grid{grid-template-columns:1fr}}
    </style>
</head>
<body>
<main class="page">
    <div style="display:flex;justify-content:space-between;align-items:center">
        <div><h1>Staff Complaints</h1><p class="muted">Report customer or event issues to the admin.</p></div>
        <a href="@Url.Action("StaffDashboard","Cust")">← Dashboard</a>
    </div>

    @if (TempData["ComplaintError"] != null) { <div class="alert">@TempData["ComplaintError"]</div> }
    @if (TempData["ComplaintSuccess"] != null) { <div class="alert success">@TempData["ComplaintSuccess"]</div> }

    <div class="grid">
        <section class="card">
            <h2>Log a Complaint</h2>
            @using (Html.BeginForm("CreateStaffComplaint", "Cust", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <label for="title">Title</label>
                <input id="title" name="title" maxlength="200" required />

                <label for="description">Description</label>
                <textarea id="description" name="description" maxlength="2000" required></textarea>

                <label for="priority">Priority</label>
                <select id="priority" name="priority">
                    <option value="Low">Low</option>
                    <option value="Medium" selected>Medium</option>
                    <option value="High">High</option>
                </select>

                <label for="bookingId">Related booking</label>
                <select id="bookingId" name="bookingId">
                    <option value="">General complaint</option>
                    @if (staffTasks != null)
                    {
                        foreach (var task in staffTasks)
                        {
                            if (task.Booking != null)
                            {
                                <option value="@task.BookingId">
                                    #@task.BookingId - @task.Booking.FirstName @task.Booking.LastName - @task.Booking.City
                                </option>
                            }
                        }
                    }
                </select>

                <button type="submit">Submit Complaint</button>
            }
        </section>

        <section class="card">
            <h2>My Complaints</h2>
            @if (!Model.Any())
            {
                <p class="muted">No complaints submitted yet.</p>
            }
            else
            {
                foreach (var complaint in Model)
                {
                    <article class="complaint">
                        <strong>@complaint.Title</strong>
                        <p class="muted">@complaint.Description</p>
                        <p class="muted">
                            Priority: @complaint.Priority |
                            Status: @complaint.Status |
                            Submitted: @complaint.CreatedAt.ToString("dd MMM yyyy HH:mm")
                        </p>
                        @if (complaint.Booking != null)
                        {
                            <p class="muted">Booking #@complaint.BookingId: @complaint.Booking.FirstName @complaint.Booking.LastName</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(complaint.AdminResponse))
                        {
                            <p><strong>Admin response:</strong> @complaint.AdminResponse</p>
                        }
                    </article>
                }
            }
        </section>
    </div>
</main>
</body>
</html>