@using WebApplication1.Models

@{
    ViewBag.Title = "Report Event Issue";

    List<StaffComplaint> myComplaints =
        ViewBag.MyComplaints as List<StaffComplaint>;
}

<style>

        .complaint-page {
            max-width: 850px;
            margin: 0 auto;
            padding: 45px 25px 70px;
        }

        .complaint-header {
            margin-bottom: 30px;
        }

        .staff-badge {
            display: inline-block;
            padding: 7px 15px;
            border-radius: 20px;
            background: #f4e8e2;
            color: #8a5b4b;
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 15px;
        }

        .complaint-header h1 {
            margin: 0 0 10px;
            font-size: 38px;
            color: #222;
        }

            .complaint-header h1 em {
                color: #b27b68;
                font-style: italic;
            }

        .complaint-header p {
            margin: 0;
            color: #777;
            font-size: 14px;
        }

        .team-info {
            margin-top: 8px;
            color: #999;
            font-size: 13px;
        }

        .back-navigation {
            margin-bottom: 25px;
        }

        .back-btn {
            display: inline-block;
            padding: 10px 17px;
            background: #222;
            color: white;
            text-decoration: none;
            border-radius: 7px;
            font-size: 13px;
            font-weight: 600;
        }

            .back-btn:hover {
                background: #444;
                color: white;
                text-decoration: none;
            }

        .complaint-message {
            padding: 14px 18px;
            margin-bottom: 20px;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 600;
        }

        .success-message {
            background: #e7f6ec;
            color: #237a42;
            border: 1px solid #c7e8d2;
        }

        .error-message {
            background: #fde8e8;
            color: #b42318;
            border: 1px solid #f5c2c2;
        }

        .complaint-card {
            background: #fff;
            border: 1px solid #eee;
            border-radius: 14px;
            padding: 28px;
            box-shadow: 0 5px 20px rgba(0,0,0,.04);
        }

            .complaint-card h2 {
                margin: 0 0 6px;
                color: #222;
                font-size: 21px;
            }

        .form-description {
            margin: 0 0 25px;
            color: #888;
            font-size: 13px;
        }

        .form-group {
            margin-bottom: 20px;
        }

            .form-group label {
                display: block;
                margin-bottom: 7px;
                color: #444;
                font-size: 13px;
                font-weight: 700;
            }

        .form-control-custom {
            width: 100%;
            box-sizing: border-box;
            padding: 11px 12px;
            border: 1px solid #ddd;
            border-radius: 7px;
            background: #fff;
            color: #333;
            font-size: 14px;
        }

            .form-control-custom:focus {
                outline: none;
                border-color: #b27b68;
            }

        textarea.form-control-custom {
            min-height: 140px;
            resize: vertical;
        }

        .field-help {
            margin-top: 5px;
            color: #999;
            font-size: 11px;
        }

        .form-actions {
            margin-top: 25px;
            padding-top: 22px;
            border-top: 1px solid #eee;
        }

        .report-btn {
            padding: 12px 22px;
            border: none;
            border-radius: 7px;
            background: #b27b68;
            color: white;
            font-size: 14px;
            font-weight: 700;
            cursor: pointer;
        }

            .report-btn:hover {
                background: #966452;
            }

        @@media (max-width: 700px) {

            .complaint-header h1 {
                font-size: 32px;
            }

            .complaint-card {
                padding: 22px;
            }
        }

        /* ==========================================
       MY REPORTED ISSUES
    ========================================== */

        .my-issues-section {
            margin-top: 35px;
            background: #111;
            border: 1px solid #333;
            border-radius: 14px;
            overflow: hidden;
        }

        .my-issues-header {
            padding: 22px 25px;
            border-bottom: 1px solid #333;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
        }

            .my-issues-header h2 {
                margin: 0 0 5px;
                color: #fff;
                font-size: 20px;
            }

            .my-issues-header p {
                margin: 0;
                color: #aaa;
                font-size: 13px;
            }

        .issue-count {
            background: #ff0066;
            color: #fff;
            padding: 7px 13px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 700;
            white-space: nowrap;
        }

        .issues-table-wrapper {
            width: 100%;
            overflow-x: auto;
        }

        .issues-table {
            width: 100%;
            border-collapse: collapse;
        }

            .issues-table th {
                padding: 14px 16px;
                text-align: left;
                color: #aaa;
                font-size: 11px;
                text-transform: uppercase;
                letter-spacing: .5px;
                border-bottom: 1px solid #333;
            }

            .issues-table td {
                padding: 17px 16px;
                color: #eee;
                font-size: 13px;
                vertical-align: top;
                border-bottom: 1px solid #222;
            }

            .issues-table tbody tr:last-child td {
                border-bottom: none;
            }

            .issues-table small {
                color: #999;
            }

        .issue-badge {
            display: inline-block;
            padding: 5px 10px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 700;
            white-space: nowrap;
        }

        .issue-priority-high {
            background: #40151a;
            color: #ff6875;
        }

        .issue-priority-medium {
            background: #3d3012;
            color: #ffd15c;
        }

        .issue-priority-low {
            background: #12351f;
            color: #59e78a;
        }

        .issue-status-open {
            background: #3d3012;
            color: #ffd15c;
        }

        .issue-status-resolved {
            background: #12351f;
            color: #59e78a;
        }

        .awaiting-resolution {
            color: #999;
            font-style: italic;
        }

        .issues-empty {
            padding: 40px 20px;
            text-align: center;
            color: #999;
        }

            .issues-empty strong {
                color: #fff;
            }

            .issues-empty p {
                margin: 7px 0 0;
            }

        @@media (max-width: 750px) {

            .my-issues-header {
                flex-direction: column;
                align-items: flex-start;
            }
        }
</style>


<div class="complaint-page">

    <!-- ==========================================
         HEADER
         ========================================== -->

    <section class="complaint-header">

        <div class="staff-badge">
            Staff Access
        </div>

        <h1>
            Report <em>Event Issue</em>
        </h1>

        <p>
            Report a problem relating to an approved event.
        </p>

        <div class="team-info">
            @ViewBag.StaffName · @ViewBag.TeamCity Team
        </div>

    </section>


    <!-- ==========================================
         NAVIGATION
         ========================================== -->

    <div class="back-navigation">

        <a href="@Url.Action("StaffDashboard", "Cust")"
           class="back-btn">
            ← Back to Dashboard
        </a>

    </div>


    <!-- ==========================================
         MESSAGES
         ========================================== -->

    @if (TempData["ComplaintSuccess"] != null)
    {
        <div class="complaint-message success-message">
            @TempData["ComplaintSuccess"]
        </div>
    }

    @if (TempData["ComplaintError"] != null)
    {
        <div class="complaint-message error-message">
            @TempData["ComplaintError"]
        </div>
    }


    <!-- ==========================================
         REPORT FORM
         ========================================== -->

    <section class="complaint-card">

        <h2>Issue Details</h2>

        <p class="form-description">
            Select the event and provide information about
            the problem you encountered.
        </p>


        @using (Html.BeginForm(
            "StaffComplaints",
            "Cust",
            FormMethod.Post))
        {
            @Html.AntiForgeryToken()


            <!-- EVENT -->

            <div class="form-group">

                <label for="bookingId">
                    Event
                </label>

                @Html.DropDownList(
                    "bookingId",
                    ViewBag.EventOptions as SelectList,
                    "-- Select Event --",
                    new
                    {
                        @class = "form-control-custom",
                        required = "required"
                    })

                <div class="field-help">
                    Only approved events belonging to your team are shown.
                </div>

            </div>


            <!-- SUBJECT -->

            <div class="form-group">

                <label for="subject">
                    Issue Subject
                </label>

                <input type="text"
                       id="subject"
                       name="subject"
                       maxlength="150"
                       class="form-control-custom"
                       placeholder="e.g. Missing decorations"
                       required />

            </div>


            <!-- DESCRIPTION -->

            <div class="form-group">

                <label for="description">
                    Description
                </label>

                <textarea id="description"
                          name="description"
                          maxlength="1000"
                          class="form-control-custom"
                          placeholder="Explain what happened and what assistance is required..."
                          required></textarea>

                <div class="field-help">
                    Include enough information for the admin to understand the issue.
                </div>

            </div>


            <!-- PRIORITY -->

            <div class="form-group">

                <label for="priority">
                    Priority
                </label>

                <select id="priority"
                        name="priority"
                        class="form-control-custom"
                        required>

                    <option value="">
                        -- Select Priority --
                    </option>

                    <option value="Low">
                        Low
                    </option>

                    <option value="Medium">
                        Medium
                    </option>

                    <option value="High">
                        High
                    </option>

                </select>

            </div>


            <!-- SUBMIT -->

            <div class="form-actions">

                <button type="submit"
                        class="report-btn">
                    Report Issue
                </button>

            </div>
        }


        <!-- ==========================================
             MY REPORTED ISSUES
        =========================================== -->

        <section class="my-issues-section">

            <div class="my-issues-header">

                <div>
                    <h2>My Reported Issues</h2>

                    <p>
                        Track the status of issues you have reported.
                    </p>
                </div>

                <span class="issue-count">
                    @(myComplaints != null ? myComplaints.Count : 0) Reported
                </span>

            </div>


            @if (myComplaints != null && myComplaints.Any())
            {
                <div class="issues-table-wrapper">

                    <table class="issues-table">

                        <thead>
                            <tr>
                                <th>Event</th>
                                <th>Issue</th>
                                <th>Priority</th>
                                <th>Reported</th>
                                <th>Status</th>
                                <th>Resolved</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var complaint in myComplaints)
                            {
                                string priorityClass =
                                    complaint.Priority == "High"
                                        ? "issue-priority-high"
                                        : complaint.Priority == "Medium"
                                            ? "issue-priority-medium"
                                            : "issue-priority-low";

                                string statusClass =
                                    complaint.Status == "Resolved"
                                        ? "issue-status-resolved"
                                        : "issue-status-open";

                                <tr>

                                    <!-- EVENT -->
                                    <td>

                                        @if (complaint.Booking != null)
                                        {
                                            <strong>
                                                @complaint.Booking.Occasion
                                            </strong>

                                            <br />

                                            <small>
                                                Booking #@complaint.BookingId
                                            </small>

                                            <br />

                                            <small>
                                                @complaint.Booking.EventDate.ToString("dd MMM yyyy")
                                            </small>
                                        }
                                        else
                                        {
                                            <span>
                                                Booking #@complaint.BookingId
                                            </span>
                                        }

                                    </td>


                                    <!-- ISSUE -->
                                    <td>

                                        <strong>
                                            @complaint.Subject
                                        </strong>

                                        <br />

                                        <small>
                                            @complaint.Description
                                        </small>

                                    </td>


                                    <!-- PRIORITY -->
                                    <td>

                                        <span class="issue-badge @priorityClass">
                                            @complaint.Priority
                                        </span>

                                    </td>


                                    <!-- REPORTED -->
                                    <td>

                                        @complaint.CreatedAt.ToString("dd MMM yyyy")

                                        <br />

                                        <small>
                                            @complaint.CreatedAt.ToString("hh:mm tt")
                                        </small>

                                    </td>


                                    <!-- STATUS -->
                                    <td>

                                        <span class="issue-badge @statusClass">
                                            @complaint.Status
                                        </span>

                                    </td>


                                    <!-- RESOLVED -->
                                    <td>

                                        @if (complaint.ResolvedAt.HasValue)
                                        {
                                            <span>
                                                @complaint.ResolvedAt.Value.ToString("dd MMM yyyy")
                                            </span>

                                            <br />

                                            <small>
                                                @complaint.ResolvedAt.Value.ToString("hh:mm tt")
                                            </small>
                                        }
                                        else
                                        {
                                            <span class="awaiting-resolution">
                                                Awaiting resolution
                                            </span>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="issues-empty">

                    <strong>
                        No issues reported yet.
                    </strong>

                    <p>
                        Issues you report for events will appear here.
                    </p>

                </div>
            }

        </section>


    </section>

</div>