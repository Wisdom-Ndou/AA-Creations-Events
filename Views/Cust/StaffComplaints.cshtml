@model IEnumerable<WebApplication1.Models.StaffComplaint>
@{
    ViewBag.Title = "Staff Complaints";
    var staffTasks = ViewBag.StaffTasks as IEnumerable<WebApplication1.Models.StaffTask>;
}

<link rel="stylesheet" href="~/Content/StaffPortal.css" />
<main class="staff-page">
    <div style="display:flex;justify-content:space-between;align-items:center">
        <div><h1>Staff Complaints</h1><p class="staff-muted">Report customer or event issues to the admin.</p></div>
        <a href="@Url.Action("StaffDashboard","Cust")">← Dashboard</a>
    </div>

    @if (TempData["ComplaintError"] != null) { <div class="alert">@TempData["ComplaintError"]</div> }
    @if (TempData["ComplaintSuccess"] != null) { <div class="alert success">@TempData["ComplaintSuccess"]</div> }

    <div class="staff-grid">
        <section class="staff-panel">
            <h2>Log a Complaint</h2>
            @using (Html.BeginForm("CreateStaffComplaint", "Cust", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <label for="title">Title</label>
                <input id="title" name="title" maxlength="200" required />

                <label for="description">Description</label>
                <textarea id="description" name="description" maxlength="2000" required></textarea>

                <label for="priority">Priority</label>
                <select id="priority" name="priority">
                    <option value="Low">Low</option>
                    <option value="Medium" selected>Medium</option>
                    <option value="High">High</option>
                </select>

                <label for="bookingId">Related booking</label>
                <select id="bookingId" name="bookingId">
                    <option value="">General complaint</option>
                    @if (staffTasks != null)
                    {
                        foreach (var task in staffTasks)
                        {
                            if (task.Booking != null)
                            {
                                <option value="@task.BookingId">
                                    #@task.BookingId - @task.Booking.FirstName @task.Booking.LastName - @task.Booking.City
                                </option>
                            }
                        }
                    }
                </select>

                <button type="submit">Submit Complaint</button>
            }
        </section>

        <section class="staff-panel">
            <h2>My Complaints</h2>
            @if (!Model.Any())
            {
                <p class="staff-muted">No complaints submitted yet.</p>
            }
            else
            {
                foreach (var complaint in Model)
                {
                    <article class="complaint">
                        <strong>@complaint.Title</strong>
                        <p class="staff-muted">@complaint.Description</p>
                        <p class="staff-muted">
                            Priority: @complaint.Priority |
                            Status: @complaint.Status |
                            Submitted: @complaint.CreatedAt.ToString("dd MMM yyyy HH:mm")
                        </p>
                        @if (complaint.Booking != null)
                        {
                            <p class="staff-muted">Booking #@complaint.BookingId: @complaint.Booking.FirstName @complaint.Booking.LastName</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(complaint.AdminResponse))
                        {
                            <p><strong>Admin response:</strong> @complaint.AdminResponse</p>
                        }
                    </article>
                }
            }
        </section>
    </div>
</main>
