@model WebApplication1.Models.AllBookingsViewModel

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>All Bookings - AA Creations & Events</title>

    <link rel="stylesheet"
          href="~/Content/AdminDashboard.css" />

</head>

<body>

    <!-- ==========================================
         PAGE HEADER
    =========================================== -->

    <section class="page-head">

        <div class="badge">
            Admin Access
        </div>

        <h1>
            All <em>Bookings</em>
        </h1>

        <p>
            View and manage all customer bookings.
        </p>

    </section>


    <main class="main">


        <!-- ==========================================
             SUMMARY
        =========================================== -->

        <section class="stat-row dashboard-widgets">

            <div class="stat-card">

                <div class="label">
                    Total Bookings
                </div>

                <div class="value">
                    @Model.TotalBookings
                </div>

                <div class="delta">
                    All bookings
                </div>

            </div>


            <div class="stat-card">

                <div class="label">
                    Upcoming
                </div>

                <div class="value">
                    @Model.UpcomingBookingCount
                </div>

                <div class="delta">
                    Confirmed upcoming events
                </div>

            </div>


            <div class="stat-card">

                <div class="label">
                    Past Events
                </div>

                <div class="value">
                    @Model.PastBookingCount
                </div>

                <div class="delta">
                    Events already completed
                </div>

            </div>


            <div class="stat-card">

                <div class="label">
                    Cancelled
                </div>

                <div class="value">
                    @Model.CancelledBookingCount
                </div>

                <div class="delta down">
                    Cancelled bookings
                </div>

            </div>

        </section>


        <!-- ==========================================
             ALL BOOKINGS
        =========================================== -->

        <div class="panel">

            <div class="panel-head">

                <div>

                    <h2>
                        All Bookings
                    </h2>

                    <p>
                        Every booking currently stored in the database
                    </p>

                </div>

            </div>


            <div class="table-wrap">

                <table>

                    <thead>

                        <tr>

                            <th>
                                Booking ID
                            </th>

                            <th>
                                Client
                            </th>

                            <th>
                                Event
                            </th>

                            <th>
                                City
                            </th>

                            <th>
                                Date / Venue Address
                            </th>

                            <th>
                                Time
                            </th>

                            <th>
                                Package
                            </th>

                            <th>
                                Total
                            </th>

                            <th>
                                Status
                            </th>

                            <th>
                                Actions
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @if (Model.AllBookings != null &&
                             Model.AllBookings.Any())
                        {
                            foreach (var booking in Model.AllBookings)
                            {
                                string clientName =
                                    ((booking.FirstName ?? "") + " " +
                                     (booking.LastName ?? "")).Trim();

                                if (string.IsNullOrWhiteSpace(clientName))
                                {
                                    clientName = "Customer";
                                }

                                string status =
                                    string.IsNullOrWhiteSpace(booking.Status)
                                        ? "Pending"
                                        : booking.Status;

                                string statusClass =
                                    status.Equals(
                                        "Approved",
                                        StringComparison.OrdinalIgnoreCase)
                                        ? "approved"
                                        : status.Equals(
                                            "Declined",
                                            StringComparison.OrdinalIgnoreCase)
                                            ? "declined"
                                            : "pending";


                                <tr>

                                    <!-- BOOKING ID -->

                                    <td class="cell-id">
                                        #BK-@booking.BookingId
                                    </td>


                                    <!-- CLIENT -->

                                    <td>
                                        @clientName
                                    </td>


                                    <!-- EVENT -->

                                    <td>
                                        @booking.Occasion
                                    </td>


                                    <!-- CITY -->

                                    <td>
                                        @booking.City
                                    </td>


                                    <!-- DATE / ADDRESS -->

                                    <td>

                                        <strong>
                                            @booking.EventDate.ToString("dd MMM yyyy")
                                        </strong>

                                        <br />

                                        <span class="venue-address">
                                            @booking.Address
                                        </span>

                                    </td>


                                    <!-- TIME -->

                                    <td>
                                        @booking.EventTime
                                    </td>


                                    <!-- PACKAGE -->

                                    <td>
                                        @booking.PackageId
                                    </td>


                                    <!-- TOTAL -->

                                    <td>
                                        R @booking.TotalPrice.ToString("N2")
                                    </td>


                                    <!-- STATUS -->

                                    <td>

                                        <span class="status @statusClass">

                                            <span class="dot"></span>

                                            @status

                                        </span>

                                    </td>


                                    <!-- ACTIONS -->

                                    <td class="booking-actions">

                                        @if (status.Equals(
                                            "Pending",
                                            StringComparison.OrdinalIgnoreCase))
                                        {
                                            <!-- APPROVE -->

                                            <form action="@Url.Action("UpdateBookingStatus", "Cust")"
                                                  method="post"
                                                  style="display:inline;">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="bookingId"
                                                       value="@booking.BookingId" />

                                                <input type="hidden"
                                                       name="status"
                                                       value="Approved" />

                                                <button type="submit"
                                                        class="approve-btn">
                                                    Approve
                                                </button>

                                            </form>


                                            <!-- DECLINE -->

                                            <form action="@Url.Action("UpdateBookingStatus", "Cust")"
                                                  method="post"
                                                  style="display:inline;">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="bookingId"
                                                       value="@booking.BookingId" />

                                                <input type="hidden"
                                                       name="status"
                                                       value="Declined" />

                                                <button type="submit"
                                                        class="decline-btn">
                                                    Decline
                                                </button>

                                            </form>
                                        }
                                        else if (status.Equals(
                                            "Approved",
                                            StringComparison.OrdinalIgnoreCase))
                                        {
                                            <!-- ASSIGN STAFF TASK -->

                                            <a href="@Url.Action(
                                    "AssignStaffTask",
                                    "Cust",
                                    new
                                    {
                                        bookingId = booking.BookingId
                                    })"
                                               class="assign-staff-btn">

                                                Assign Staff Task

                                            </a>
                                        }
                                        else
                                        {
                                            <span class="no-action">
                                                Reviewed
                                            </span>
                                        }

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="10"
                                    style="text-align:center;">

                                    No bookings have been made yet.

                                </td>

                            </tr>
                        }

                    </tbody>


                    </table>

            </div>


            <div class="table-foot">

                <span>

                    Showing
                    @Model.TotalBookings
                    booking(s)

                </span>

            </div>

        </div>


        <!-- ==========================================
             BACK TO DASHBOARD
        =========================================== -->

        <div style="margin-top: 20px;">

            <a href="@Url.Action("AdminDashboard", "Cust")"
               class="quick-action">

                ← Back to Admin Dashboard

            </a>

        </div>

    </main>



</body>

</html>