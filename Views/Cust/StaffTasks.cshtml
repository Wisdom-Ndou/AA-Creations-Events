@using System
@using System.Linq
@model IEnumerable<WebApplication1.Models.StaffTask>
@{ ViewBag.Title = "My Tasks"; }
<link rel="stylesheet" href="~/Content/StaffPortal.css" />
<style>
    .staff-task-list{display:grid;gap:16px}
    .staff-task-card{background:#fff;border:1px solid var(--staff-border);border-radius:16px;padding:20px;box-shadow:0 7px 22px rgba(72,33,52,.06)}
    .staff-task-top{display:flex;justify-content:space-between;gap:18px;align-items:flex-start}
    .staff-task-title{font-size:1.08rem;font-weight:800;color:var(--staff-text);margin-bottom:5px}
    .staff-task-meta{color:var(--staff-muted);line-height:1.55;margin:.25rem 0}
    .staff-task-form{margin-top:18px;padding-top:18px;border-top:1px solid #efe3e9}
    .staff-task-actions{display:grid;grid-template-columns:minmax(180px,.65fr) minmax(0,1.6fr);gap:14px;align-items:stretch}
    .task-complete-btn,.task-unable-btn{border:0;border-radius:12px;padding:13px 17px;font-weight:800;cursor:pointer;transition:transform .18s ease,box-shadow .18s ease,filter .18s ease}
    .task-complete-btn{background:#edf9f3;color:#17643f;border:1px solid #a7d9c1}
    .task-complete-btn:hover{transform:translateY(-1px);box-shadow:0 8px 18px rgba(23,100,63,.12);filter:brightness(.98)}
    .task-unable-panel{display:flex;gap:10px;align-items:flex-end;padding:12px;border:1px solid #ecd9e2;border-radius:14px;background:#fff8fb}
    .task-reason-group{flex:1;min-width:0}
    .task-reason-label{display:block;margin:0 0 6px;font-size:.78rem;font-weight:800;color:var(--staff-text)}
    .task-reason-label span{font-weight:500;color:var(--staff-muted)}
    .task-reason-input{width:100%;box-sizing:border-box;min-height:44px;padding:11px 12px;border:1px solid #d9c6d0;border-radius:10px;background:#fff;color:var(--staff-text);outline:none;resize:vertical;font:inherit}
    .task-reason-input:focus{border-color:var(--staff-pink);box-shadow:0 0 0 3px rgba(194,24,91,.10)}
    .task-reason-input.invalid{border-color:var(--staff-danger);box-shadow:0 0 0 3px rgba(141,36,74,.09)}
    .task-unable-btn{background:#fff0f5;color:#8d244a;border:1px solid #efb7c9;white-space:nowrap}
    .task-unable-btn:hover{transform:translateY(-1px);box-shadow:0 8px 18px rgba(141,36,74,.12);filter:brightness(.98)}
    .staff-toolbar{display:flex;justify-content:space-between;gap:15px;align-items:center;margin-bottom:20px}
    @@media(max-width:760px){.staff-task-actions{grid-template-columns:1fr}.task-unable-panel{align-items:stretch;flex-direction:column}.task-unable-btn{width:100%}}
    @@media(max-width:640px){.staff-task-top,.staff-toolbar{flex-direction:column}}
</style>
<main class="staff-page">
    <header class="staff-hero">
        <div class="staff-eyebrow">Staff Portal</div>
        <h1>My To-Do List</h1>
        <p>Review assigned bookings, event details and task status.</p>
    </header>
    <div class="staff-toolbar">
        <strong>@Model.Count() task(s)</strong>
        <a class="staff-link" href="@Url.Action("StaffDashboard","Cust")"></a>
    </div>

    @if (TempData["StaffTaskError"] != null) { <div class="alert">@TempData["StaffTaskError"]</div> }
    @if (TempData["StaffTaskSuccess"] != null) { <div class="alert success">@TempData["StaffTaskSuccess"]</div> }

    <section class="staff-task-list">
    @if (!Model.Any())
    {
        <article class="staff-panel"><h2>No assigned tasks</h2><p class="staff-muted">You currently have no booking tasks assigned to you.</p></article>
    }
    else
    {
        foreach (var task in Model)
        {
            var statusClass=(task.Status ?? "Pending").ToLowerInvariant();
            <article class="staff-task-card">
                <div class="staff-task-top">
                    <div>
                        <div class="staff-task-title">@task.TaskName</div>
                        <p class="staff-task-meta">@task.Description</p>
                        @if (task.Booking != null)
                        {
                            <p class="staff-task-meta"><strong>Customer:</strong> @task.Booking.FirstName @task.Booking.LastName</p>
                            <p class="staff-task-meta"><strong>Event:</strong> @task.Booking.Occasion  @task.Booking.EventDate.ToString("dd MMM yyyy") @task.Booking.EventTime</p>
                            <p class="staff-task-meta"><strong>Location:</strong> @task.Booking.Address, @task.Booking.City</p>
                        }
                        <p class="staff-task-meta"><strong>Priority:</strong> @task.Priority</p>
                    </div>
                    <span class="staff-status @statusClass">@task.Status</span>
                </div>

                @if (String.Equals(task.Status,"Pending",StringComparison.OrdinalIgnoreCase))
                {
                    using (Html.BeginForm("UpdateStaffTask","Cust",FormMethod.Post,new { @class="staff-task-form", data_task_form="true" }))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="taskId" value="@task.TaskId" />

                        <div class="staff-task-actions">
                            <button class="task-complete-btn" type="submit" name="status" value="Completed">
                                 Mark Complete
                            </button>

                            <div class="task-unable-panel">
                                <div class="task-reason-group">
                                    <label class="task-reason-label" for="reason-@task.TaskId">
                                        Reason if you cannot complete the task
                                        <span> required only for Unable</span>
                                    </label>
                                    <textarea class="task-reason-input"
                                              id="reason-@task.TaskId"
                                              name="completionReason"
                                              rows="2"
                                              maxlength="1000"
                                              placeholder="Briefly explain what is preventing completion"></textarea>
                                </div>

                                <button class="task-unable-btn" type="submit" name="status" value="Unable">
                                     Unable to Complete
                                </button>
                            </div>
                        </div>
                    }
                }
                else if (!String.IsNullOrWhiteSpace(task.CompletionReason))
                {
                    <p class="staff-task-meta"><strong>Completion note:</strong> @task.CompletionReason</p>
                }
            </article>
        }
    }
    </section>
</main>

<script>
    document.querySelectorAll('[data-task-form="true"]').forEach(function (form) {
        var reason = form.querySelector('.task-reason-input');
        var unable = form.querySelector('.task-unable-btn');

        if (!reason || !unable) return;

        unable.addEventListener('click', function (event) {
            if (reason.value.trim()) {
                reason.classList.remove('invalid');
                return;
            }

            event.preventDefault();
            reason.classList.add('invalid');
            reason.focus();
        });

        reason.addEventListener('input', function () {
            if (reason.value.trim()) {
                reason.classList.remove('invalid');
            }
        });
    });
</script>