@using System
@using System.Linq
@model IEnumerable<WebApplication1.Models.StaffTask>
@{ ViewBag.Title = "My Tasks"; }
<link rel="stylesheet" href="~/Content/StaffPortal.css" />
<style>
    .staff-task-list{display:grid;gap:16px}
    .staff-task-card{background:#fff;border:1px solid var(--staff-border);border-radius:16px;padding:20px;box-shadow:0 7px 22px rgba(72,33,52,.06)}
    .staff-task-top{display:flex;justify-content:space-between;gap:18px;align-items:flex-start}
    .staff-task-title{font-size:1.08rem;font-weight:800;color:var(--staff-text);margin-bottom:5px}
    .staff-task-meta{color:var(--staff-muted);line-height:1.55;margin:.25rem 0}
    .staff-task-form{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-top:16px;padding-top:16px;border-top:1px solid #efe3e9}
    .staff-task-form input{flex:1;min-width:250px}
    .staff-task-form .complete{background:var(--staff-success)}
    .staff-task-form .unable{background:var(--staff-danger)}
    .staff-toolbar{display:flex;justify-content:space-between;gap:15px;align-items:center;margin-bottom:20px}
    @@media(max-width:640px){.staff-task-top,.staff-toolbar{flex-direction:column}.staff-task-form{align-items:stretch}.staff-task-form input{min-width:0}}
</style>
<main class="staff-page">
    <header class="staff-hero">
        <div class="staff-eyebrow">Staff Portal</div>
        <h1>My To-Do List</h1>
        <p>Review assigned bookings, event details and task status.</p>
    </header>
    <div class="staff-toolbar">
        <strong>@Model.Count() task(s)</strong>
        <a class="staff-link" href="@Url.Action("StaffDashboard","Cust")">← Back to dashboard</a>
    </div>

    @if (TempData["StaffTaskError"] != null) { <div class="alert">@TempData["StaffTaskError"]</div> }
    @if (TempData["StaffTaskSuccess"] != null) { <div class="alert success">@TempData["StaffTaskSuccess"]</div> }

    <section class="staff-task-list">
    @if (!Model.Any())
    {
        <article class="staff-panel"><h2>No assigned tasks</h2><p class="staff-muted">You currently have no booking tasks assigned to you.</p></article>
    }
    else
    {
        foreach (var task in Model)
        {
            var statusClass=(task.Status ?? "Pending").ToLowerInvariant();
            <article class="staff-task-card">
                <div class="staff-task-top">
                    <div>
                        <div class="staff-task-title">@task.TaskName</div>
                        <p class="staff-task-meta">@task.Description</p>
                        @if (task.Booking != null)
                        {
                            <p class="staff-task-meta"><strong>Customer:</strong> @task.Booking.FirstName @task.Booking.LastName</p>
                            <p class="staff-task-meta"><strong>Event:</strong> @task.Booking.Occasion · @task.Booking.EventDate.ToString("dd MMM yyyy") @task.Booking.EventTime</p>
                            <p class="staff-task-meta"><strong>Location:</strong> @task.Booking.Address, @task.Booking.City</p>
                        }
                        <p class="staff-task-meta"><strong>Priority:</strong> @task.Priority</p>
                    </div>
                    <span class="staff-status @statusClass">@task.Status</span>
                </div>

                @if (String.Equals(task.Status,"Pending",StringComparison.OrdinalIgnoreCase))
                {
                    using (Html.BeginForm("UpdateStaffTask","Cust",FormMethod.Post,new { @class="staff-task-form" }))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="taskId" value="@task.TaskId" />
                        <button class="complete" type="submit" name="status" value="Completed">Mark Complete</button>
                        <input type="text" name="completionReason" placeholder="Reason if you cannot complete the task" maxlength="1000" />
                        <button class="unable" type="submit" name="status" value="Unable">Unable to Complete</button>
                    }
                }
                else if (!String.IsNullOrWhiteSpace(task.CompletionReason))
                {
                    <p class="staff-task-meta"><strong>Completion note:</strong> @task.CompletionReason</p>
                }
            </article>
        }
    }
    </section>
</main>