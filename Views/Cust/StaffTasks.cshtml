@using System.Linq
@model IEnumerable<WebApplication1.Models.StaffTask>
@{
    ViewBag.Title = "My Tasks";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>My Tasks</title>
    <style>
        body{margin:0;background:#111;color:#fff;font-family:Segoe UI,Arial,sans-serif}.page{max-width:1100px;margin:auto;padding:32px 20px}.card{background:#1b1b1b;border:1px solid #333;border-radius:16px;padding:20px;margin-bottom:16px}.top{display:flex;justify-content:space-between;gap:20px;align-items:center}.task-title{font-size:1.15rem;font-weight:700}.muted{color:#aaa}.status{display:inline-block;padding:5px 10px;border-radius:999px;border:1px solid #555;font-size:.8rem}.form{margin-top:16px;display:flex;gap:10px;flex-wrap:wrap}.form button,.form textarea{font:inherit}.form button{padding:9px 14px;border:0;border-radius:7px;cursor:pointer}.complete{background:#fff;color:#111}.unable{background:#ff5f91;color:#111}.reason{min-width:280px;flex:1;padding:9px;border-radius:7px;border:1px solid #444;background:#111;color:#fff}.alert{padding:12px;border-radius:8px;margin-bottom:16px;background:#241f12;color:#ffd86b}.success{background:#142519;color:#80e59a}a{color:#ff5f91;text-decoration:none}
    </style>
</head>
<body>
<main class="page">
    <div class="top">
        <div><h1>My To-Do List</h1><p class="muted">Bookings assigned to you by city.</p></div>
        <a href="@Url.Action("StaffDashboard","Cust")">← Dashboard</a>
    </div>

    @if (TempData["StaffTaskError"] != null) { <div class="alert">@TempData["StaffTaskError"]</div> }
    @if (TempData["StaffTaskSuccess"] != null) { <div class="alert success">@TempData["StaffTaskSuccess"]</div> }

    @if (!Model.Any())
    {
        <div class="card"><p class="muted">You have no assigned tasks.</p></div>
    }
    else
    {
        foreach (var task in Model)
        {
            <article class="card">
                <div class="top">
                    <div>
                        <div class="task-title">@task.TaskName</div>
                        <p class="muted">@task.Description</p>
                        @if (task.Booking != null)
                        {
                            <p class="muted">
                                Customer: @task.Booking.FirstName @task.Booking.LastName |
                                Event: @task.Booking.EventDate.ToString("dd MMM yyyy") @task.Booking.EventTime |
                                @task.Booking.Address, @task.Booking.City
                            </p>
                        }
                    </div>
                    <span class="status">@task.Status</span>
                </div>

                @if (task.Status == "Pending")
                {
                    using (Html.BeginForm("UpdateStaffTask", "Cust", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="taskId" value="@task.TaskId" />
                        <div class="form">
                            <button class="complete" type="submit" name="status" value="Completed">Mark Complete</button>
                            <input class="reason" type="text" name="completionReason" placeholder="Reason if you cannot complete the task" maxlength="1000" />
                            <button class="unable" type="submit" name="status" value="Unable">Unable to Complete</button>
                        </div>
                    }
                }
                else if (!string.IsNullOrWhiteSpace(task.CompletionReason))
                {
                    <p class="muted"><strong>Reason:</strong> @task.CompletionReason</p>
                }
            </article>
        }
    }
</main>
</body>
</html>