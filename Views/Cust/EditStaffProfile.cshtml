@model WebApplication1.Models.Staff

@{
    ViewBag.Title = "Edit Profile";
}

<div class="edit-profile-page">

    <div class="edit-header">

        <div>
            <span class="staff-badge">
                Staff Access
            </span>

            <h1>Edit Profile</h1>

            <p>
                Update your personal contact information.
            </p>

            <div class="profile-header-actions">

                <a href="@Url.Action("EditStaffProfile", "Cust")"
                   class="edit-profile-button">
                    Edit Profile
                </a>

                <a href="@Url.Action("StaffDashboard", "Cust")"
                   class="back-button">
                    Back to Dashboard
                </a>

            </div>


    @if (TempData["ProfileError"] != null)
    {
        <div class="message error-message">
            @TempData["ProfileError"]
        </div>
    }


    <div class="edit-card">

        @using (Html.BeginForm(
            "EditStaffProfile",
            "Cust",
            FormMethod.Post,
            new { @class = "profile-form" }))
        {
            @Html.AntiForgeryToken()


            <div class="form-grid">

                <div class="form-group">

                    <label>First Name</label>

                    <input type="text"
                           name="firstName"
                           value="@Model.staff_FName"
                           maxlength="100"
                           required />

                </div>


                <div class="form-group">

                    <label>Last Name</label>

                    <input type="text"
                           name="lastName"
                           value="@Model.staff_LName"
                           maxlength="100"
                           required />

                </div>


                <div class="form-group">

                    <label>Email Address</label>

                    <input type="email"
                           name="email"
                           value="@Model.staff_Email"
                           required />

                </div>


                <div class="form-group">

                    <label>Phone Number</label>

                    <input type="tel"
                           name="phone"
                           value="@Model.staff_Phone"
                           maxlength="10"
                           pattern="[0-9]{10}"
                           required />

                    <small>
                        Enter exactly 10 digits.
                    </small>

                </div>


                <div class="form-group readonly-field">

                    <label>Staff Team</label>

                    <input type="text"
                           value="@Model.staff_Type"
                           readonly />

                    <small>
                        Team assignments can only be changed by an administrator.
                    </small>

                </div>

            </div>


            <div class="form-actions">

                <a href="@Url.Action("StaffProfile", "Cust")"
                   class="cancel-btn">
                    Cancel
                </a>

                <button type="submit"
                        class="save-btn">
                    Save Changes
                </button>

            </div>
        }

    </div>

</div>


<style>

    body {
        background: #080808;
    }

    .edit-profile-page {
        max-width: 900px;
        margin: 40px auto;
        padding: 0 20px 50px;
        color: #fff;
    }

    .edit-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 20px;
        margin-bottom: 30px;
    }

        .edit-header h1 {
            margin: 10px 0 5px;
        }

        .edit-header p {
            margin: 0;
            color: #999;
        }

    .staff-badge {
        display: inline-block;
        padding: 6px 12px;
        background: #ff0066;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700;
    }

    .back-btn,
    .cancel-btn {
        color: #fff;
        text-decoration: none;
        border: 1px solid #444;
        border-radius: 8px;
        padding: 10px 16px;
    }

        .back-btn:hover,
        .cancel-btn:hover {
            color: #ff0066;
            border-color: #ff0066;
            text-decoration: none;
        }

    .message {
        padding: 13px 16px;
        border-radius: 8px;
        margin-bottom: 20px;
    }

    .error-message {
        background: #40151a;
        color: #ff6875;
        border: 1px solid #6c252e;
    }

    .edit-card {
        background: #111;
        border: 1px solid #333;
        border-radius: 14px;
        padding: 30px;
    }

    .form-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 22px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 7px;
    }

        .form-group label {
            color: #ddd;
            font-size: 13px;
            font-weight: 700;
        }

        .form-group input {
            width: 100%;
            box-sizing: border-box;
            padding: 12px 13px;
            background: #181818;
            border: 1px solid #444;
            border-radius: 8px;
            color: #fff;
            outline: none;
        }

            .form-group input:focus {
                border-color: #ff0066;
            }

        .form-group small {
            color: #777;
            font-size: 11px;
        }

    .readonly-field input {
        color: #999;
        cursor: not-allowed;
    }

    .form-actions {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 12px;
        margin-top: 30px;
        padding-top: 22px;
        border-top: 1px solid #333;
    }

    .save-btn {
        border: none;
        border-radius: 8px;
        background: #ff0066;
        color: #fff;
        padding: 11px 20px;
        font-weight: 700;
        cursor: pointer;
    }

        .save-btn:hover {
            opacity: .85;
        }


    @@media (max-width: 700px) {

        .edit-header {
            flex-direction: column;
        }

        .form-grid {
            grid-template-columns: 1fr;
        }

        .form-actions {
            justify-content: stretch;
        }

        .cancel-btn,
        .save-btn {
            flex: 1;
            text-align: center;
        }
    }

    .profile-header-actions {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .edit-profile-button {
        background: #ff0066;
        color: #fff;
        border: 1px solid #ff0066;
        border-radius: 8px;
        padding: 10px 16px;
        text-decoration: none;
        font-weight: 700;
    }

        .edit-profile-button:hover {
            color: #fff;
            opacity: .85;
            text-decoration: none;
        }bb

</style>
