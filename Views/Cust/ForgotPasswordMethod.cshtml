@{
    ViewBag.Title = "Forgot Password";
}

<link rel="stylesheet" href="~/Content/Manage Account styles.css" />

<div class="manage-account-page">

    <div class="account-card">

        <h2>Choose Verification Method</h2>

        <p>
            How would you like to receive your verification code?
        </p>

        @if (TempData["OtpError"] != null)
        {
            <div class="account-error">
                @TempData["OtpError"]
            </div>
        }

        @using (Html.BeginForm("ForgotPasswordMethod", "Cust", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <div class="account-field">

                <label for="deliveryMethod">
                    Send verification code via
                </label>

                <select id="deliveryMethod"
                        name="deliveryMethod"
                        class="account-input">

                    <option value="Email">Email</option>
                    <option value="Phone">Phone</option>

                </select>

            </div>

            <div class="account-field"
                 id="phoneField"
                 style="display: none;">

                <label for="phone">
                    Phone / WhatsApp
                </label>

                <div class="phone-input-wrapper">

                    <span class="phone-prefix">+27</span>

                    <input type="tel"
                           id="phone"
                           name="phone"
                           class="account-input phone-number-input"
                           inputmode="numeric"
                           maxlength="9"
                           placeholder="723456789" />

                </div>

                <small class="phone-help">
                    Enter 9 digits (do not include the leading 0).
                </small>

            </div>

            <div class="account-actions">

                <button type="submit"
                        class="save-account-btn">

                    Send Verification Code

                </button>

            </div>
        }

        <p>
            <a href="@Url.Action("ForgotPassword", "Cust")">
                Back
            </a>
        </p>

    </div>

</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        const deliveryMethod =
            document.getElementById("deliveryMethod");

        const phoneField =
            document.getElementById("phoneField");

        const phoneInput =
            document.getElementById("phone");

        function updatePhoneField() {

            if (deliveryMethod.value === "Phone") {

                phoneField.style.display = "block";
                phoneInput.required = true;

            } else {

                phoneField.style.display = "none";
                phoneInput.required = false;
                phoneInput.value = "";

            }
        }

        deliveryMethod.addEventListener(
            "change",
            updatePhoneField
        );

        updatePhoneField();

    });
</script>