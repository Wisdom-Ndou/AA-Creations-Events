@{
    ViewBag.Title = "Forgot Password";
}
<link rel="stylesheet" href="~/Content/Manage Account styles.css" />
<div class="manage-account-page">
    <div class="account-card">
        <h2>Email Verification</h2>
        <p>We will send a one-time verification code to the email address on your account.</p>
        @if (TempData["OtpError"] != null)
        {
            <div class="account-error">@TempData["OtpError"]</div>
        }
        @using (Html.BeginForm("ForgotPasswordMethod", "Cust", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="deliveryMethod" value="Email" />
            <div class="account-actions">
                <button type="submit" class="save-account-btn">Send Verification Code</button>
            </div>
        }
        <p><a href="@Url.Action("ForgotPassword", "Cust")">Back</a></p>
    </div>
</div>