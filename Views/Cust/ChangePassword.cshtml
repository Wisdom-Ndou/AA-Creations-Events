@model WebApplication1.Models.ChangePasswordViewModel

@{
    ViewBag.Title = "Change Password";
}

<link rel="stylesheet" href="~/Content/Manage Account styles.css" />

<div class="manage-account-page">

    <div class="account-card">

        <h2>Change Password</h2>

        <p>
            Your identity has been verified. Enter your new password below.
        </p>

        @using (Html.BeginForm("ChangePassword", "Cust", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <div class="account-field">

                @Html.LabelFor(
                    m => m.NewPassword,
                    "New Password"
                )

                @Html.PasswordFor(
                    m => m.NewPassword,
                    new
                    {
                        @class = "account-input",
                        autocomplete = "new-password",
                        placeholder = "Enter new password"
                    }
                )

                @Html.ValidationMessageFor(
                    m => m.NewPassword,
                    "",
                    new { @class = "account-error" }
                )

            </div>

            <div class="account-field">

                @Html.LabelFor(
                    m => m.ConfirmPassword,
                    "Confirm New Password"
                )

                @Html.PasswordFor(
                    m => m.ConfirmPassword,
                    new
                    {
                        @class = "account-input",
                        autocomplete = "new-password",
                        placeholder = "Confirm new password"
                    }
                )

                @Html.ValidationMessageFor(
                    m => m.ConfirmPassword,
                    "",
                    new { @class = "account-error" }
                )

            </div>

            @Html.ValidationSummary(
                true,
                "",
                new { @class = "account-error" }
            )

            <div class="account-actions">

                <button type="submit"
                        class="save-account-btn">
                    Change Password
                </button>

            </div>
        }

    </div>

</div>