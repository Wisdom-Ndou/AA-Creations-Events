@using System
@using System.Linq
@model WebApplication1.Models.FinancialOverviewViewModel
@{ ViewBag.Title = "Financial Overview"; }
<link rel="stylesheet" href="~/Content/AdminDashboard.css" />

<style>
    .finance-page {
        max-width: 1240px;
        margin: 0 auto;
        padding: 32px 22px;
    }

    .finance-hero {
        padding: 28px 30px;
        border-radius: 20px;
        background: linear-gradient(135deg, #12090e, #2a0f1b);
        border: 1px solid #4c2435;
        margin-bottom: 22px;
    }

        .finance-hero .eyebrow {
            color: #ff5e91;
            text-transform: uppercase;
            letter-spacing: .12em;
            font-weight: 800;
            font-size: .78rem;
        }

        .finance-hero h1 {
            margin: .35rem 0;
            color: #fff;
            font-size: 2.3rem;
        }

        .finance-hero p {
            color: #d5c6ce;
            margin: 0;
        }

    /* SUMMARY CARDS */

    .finance-summary {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
        margin-bottom: 22px;
    }

    .finance-card {
        border-radius: 18px;
        padding: 22px;
        background: #151515;
        color: #ffffff;
        box-shadow: 0 12px 32px rgba(0,0,0,.28);
        border: 1px solid #303030;
        border-top: 4px solid #ff2a6d;
    }

        .finance-card span {
            display: block;
            color: #d4a6b9;
            font-size: .82rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .05em;
        }

        .finance-card strong {
            display: block;
            font-size: 2rem;
            margin: .35rem 0;
            color: #ffffff;
        }

        .finance-card small {
            color: #bcaab3;
        }

    /* MAIN FINANCE GRID */

    .finance-grid {
        display: grid;
        grid-template-columns: minmax(0, .85fr) minmax(0, 1.35fr);
        gap: 20px;
    }

    .finance-panel {
        background: #151515;
        color: #ffffff;
        border-radius: 18px;
        padding: 22px;
        box-shadow: 0 12px 32px rgba(0,0,0,.24);
        border: 1px solid #303030;
    }

        .finance-panel h2 {
            margin: 0 0 4px;
            color: #ffffff;
        }

        .finance-panel .sub {
            color: #bcaab3;
            margin: 0 0 18px;
        }

    /* FORM */

    .finance-form {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px;
    }

    .finance-field {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

        .finance-field label {
            font-size: .86rem;
            font-weight: 700;
            color: #f2e7ec;
        }

    .finance-input {
        width: 100%;
        max-width: none;
        box-sizing: border-box;
        padding: 12px 13px;
        border: 1px solid #45323b;
        border-radius: 10px;
        background: #202020;
        color: #ffffff;
        font: inherit;
        outline: none;
        transition: border-color .2s ease, box-shadow .2s ease;
    }

        .finance-input::placeholder {
            color: #8f7e87;
        }

        .finance-input:focus {
            border-color: #ff2a6d;
            box-shadow: 0 0 0 3px rgba(255,42,109,.14);
        }

    .finance-submit {
        margin-top: 16px;
        border: 0;
        border-radius: 10px;
        padding: 12px 18px;
        background: #c2185b;
        color: #fff;
        font-weight: 800;
        cursor: pointer;
        transition: background .2s ease;
    }

        .finance-submit:hover {
            background: #e02472;
        }

    /* ALERTS */

    .finance-alert {
        padding: 12px 14px;
        border-radius: 10px;
        margin-bottom: 16px;
        background: #2a111a;
        color: #ff91b6;
        border: 1px solid #743149;
    }

        .finance-alert.success {
            background: #10271c;
            color: #70d59a;
            border-color: #2f6849;
        }

    /* EXPENDITURE TABLE */

    .finance-table-wrap {
        overflow: auto;
    }

    .finance-table {
        width: 100%;
        border-collapse: collapse;
    }

        .finance-table th,
        .finance-table td {
            text-align: left;
            padding: 11px 9px;
            border-bottom: 1px solid #303030;
            color: #f1e9ed;
        }

        .finance-table th {
            font-size: .78rem;
            text-transform: uppercase;
            letter-spacing: .04em;
            color: #ff4f8d;
        }

        .finance-table tbody tr {
            transition: background .2s ease;
        }

            .finance-table tbody tr:hover {
                background: rgba(255,42,109,.05);
            }

    /* BACK BUTTON */

    .finance-page .quick-action {
        background: #171717;
        border: 1px solid #303030;
        color: #ffffff;
    }

        .finance-page .quick-action:hover {
            border-color: #ff2a6d;
            color: #ff5e91;
            background: #211118;
        }

    /* RESPONSIVE */

    /* Keep @@media because this CSS is inside a Razor .cshtml file */
    @@media (max-width: 900px) {
        .finance-summary {
            grid-template-columns: 1fr;
        }

        .finance-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 600px) {
        .finance-form {
            grid-template-columns: 1fr;
        }

        .finance-page {
            padding: 24px 14px;
        }

        .finance-hero {
            padding: 22px;
        }
    }
</style>

<main class="finance-page">
<section class="finance-hero"><div class="eyebrow">Admin Finance</div><h1>Financial Overview</h1><p>Track confirmed income, business expenses and current operating profit.</p></section>

<section class="finance-summary">
    <article class="finance-card"><span>Total Income</span><strong>R @Model.Income.ToString("N2")</strong><small>Approved, setup-completed and completed bookings</small></article>
    <article class="finance-card"><span>Total Expenditure</span><strong>R @Model.TotalExpenditure.ToString("N2")</strong><small>Recorded operating expenses</small></article>
    <article class="finance-card"><span>Current Profit</span><strong>R @Model.Profit.ToString("N2")</strong><small>Income minus expenditure</small></article>
</section>

@if(TempData["FinanceError"]!=null){<div class="finance-alert">@TempData["FinanceError"]</div>}
@if(TempData["FinanceSuccess"]!=null){<div class="finance-alert success">@TempData["FinanceSuccess"]</div>}

<section class="finance-grid">
    <article class="finance-panel">
        <h2>Record Expenditure</h2><p class="sub">Add an actual business cost to the report.</p>
        @using(Html.BeginForm("AddExpenditure","Cust",FormMethod.Post)){
            @Html.AntiForgeryToken()
            <div class="finance-form">
                <div class="finance-field"><label for="description">Description</label><input id="description" class="finance-input" name="description" placeholder="e.g. Floral supplies" required /></div>
                <div class="finance-field"><label for="amount">Amount (R)</label><input id="amount" class="finance-input" name="amount" type="number" min="0.01" step="0.01" placeholder="0.00" required /></div>
                <div class="finance-field"><label for="expenseDate">Date</label><input id="expenseDate" class="finance-input" name="expenseDate" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" required /></div>
                <div class="finance-field"><label for="category">Category</label><input id="category" class="finance-input" name="category" placeholder="Decor, transport, supplies..." /></div>
            </div>
            <button type="submit" class="finance-submit">Record Expenditure</button>
        }
    </article>

    <article class="finance-panel">
        <h2>Expenditure History</h2><p class="sub">@Model.Expenditures.Count recorded expense(s)</p>
        @if(!Model.Expenditures.Any()){<p>No expenditure has been recorded yet.</p>}
        else{
            <div class="finance-table-wrap"><table class="finance-table"><thead><tr><th>Date</th><th>Description</th><th>Category</th><th>Amount</th></tr></thead><tbody>
            @foreach(var e in Model.Expenditures.Take(20)){<tr><td>@e.ExpenseDate.ToString("dd MMM yyyy")</td><td>@e.Description</td><td>@e.Category</td><td>R @e.Amount.ToString("N2")</td></tr>}
            </tbody></table></div>
        }
    </article>
</section>
<p style="margin-top:20px"><a class="quick-action" style="max-width:260px" href="@Url.Action("AdminDashboard","Cust")">Back to Admin Dashboard</a></p>
</main>