@model WebApplication1.Models.Staff
@{ ViewBag.Title="Edit Staff"; }
<link rel="stylesheet" href="~/Content/AdminDashboard.css" />
<main class="main"><section class="page-head"><span class="badge">Admin</span><h1>Edit <em>Staff</em></h1><p>Update staff account and team information.</p></section>
<section class="panel">@using(Html.BeginForm("EditStaff","Cust",FormMethod.Post)){@Html.AntiForgeryToken() @Html.HiddenFor(m=>m.staff_ID) @Html.ValidationSummary(false,"",new{@class="text-danger"})
<div class="form-grid">
<div class="form-group">@Html.LabelFor(m=>m.staff_FName,"First Name") @Html.TextBoxFor(m=>m.staff_FName,new{@class="form-control"})</div>
<div class="form-group">@Html.LabelFor(m=>m.staff_LName,"Last Name") @Html.TextBoxFor(m=>m.staff_LName,new{@class="form-control"})</div>
<div class="form-group">@Html.LabelFor(m=>m.staff_Email,"Email") @Html.TextBoxFor(m=>m.staff_Email,new{@class="form-control",type="email"})</div>
<div class="form-group">@Html.LabelFor(m=>m.staff_Phone,"Phone") @Html.TextBoxFor(m=>m.staff_Phone,new{@class="form-control",maxlength="9"})</div>
<div class="form-group">
<label>Team</label>
@Html.DropDownListFor(m => m.staff_Type,
    new SelectList(new[] { "Team Dbn", "Team Peter", "Team Mdn" }, Model.staff_Type),
    new { @class = "form-control" })
</div>
<div class="form-group">
<label>City</label>
<input class="form-control" type="text" value="@Model.staff_City" readonly />
<small>City is assigned automatically from the selected team when you save.</small>
</div>
<div class="form-group"><label>New Password (optional)</label><input class="form-control" type="password" name="staff_Passw" placeholder="Leave blank to keep current password"/></div></div>
<p style="margin-top:20px"><button class="approve-btn" type="submit">Save Changes</button> <a class="panel-link" href="@Url.Action("StaffManagement","Cust")">Cancel</a></p>}</section></main>