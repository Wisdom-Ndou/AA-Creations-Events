@{
    ViewBag.Title = "Adminregister";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Registration Portal | AA Creations &amp; Events</title>
    <link rel="stylesheet" href="~/Content/Styles.css" />
</head>
<body>


    <div class="page">

        <!-- ============ LEFT: BRAND PANEL (hidden on small screens) ============ -->
        <aside class="brand-panel">


            <div class="brand-top">

            </div>

            <div class="brand-mid">
                <div class="badge">
                    Admin Access
                </div>

                <h1 class="brand-title">
                    Admin<br />
                    <em>Registration</em><br />
                    Portal
                </h1>

                <div class="divider"></div>

                <p class="brand-desc">
                    All admin accounts are subject to verification by senior management.
                    Please ensure all details are accurate and your employee ID is valid.
                </p>
            </div>

            <div class="brand-bottom">
                <p class="privileges-label">Admin Responsibilities</p>
                <ul class="privileges-list">
                    <li><span class="check-icon"><span class="check-dot"></span></span>Appointement of Bookings</li>
                    <li><span class="check-icon"><span class="check-dot"></span></span>User Account Management</li>
                    <li><span class="check-icon"><span class="check-dot"></span></span>Portfolio Editing &amp; Review</li>
                    <li><span class="check-icon"><span class="check-dot"></span></span>Financial Reporting</li>
                    <li><span class="check-icon"><span class="check-dot"></span></span>Staff Communication</li>
                </ul>
            </div>
        </aside>




        <main class="form-panel">
            <div class="form-wrap" id="formWrap">
                <h2 class="form-title">Create Admin Account</h2>
                <p class="form-subtitle">All fields are required — your request will be reviewed before activation</p>

                @using (Html.BeginForm("Adminregister", "Cust", FormMethod.Post, new { id = "adminForm", novalidate = "novalidate" }))
                {
                    @Html.AntiForgeryToken()

                    <section class="form-section">
                        <p class="section-label">Identity</p>
                        <div class="grid-2">
                            <div class="field">
                                <label for="firstName">First Name</label>
                                <input type="text"
                                       id="firstName"
                                       name="firstName"
                                       placeholder="Thabo"
                                       required
                                       pattern="^[A-Za-z]+$"
                                       title="Only letters allowed"
                                       aria-describedby="firstNameError"
                                       aria-invalid="false" />
                                <p class="error-text" id="firstNameError" aria-live="polite" hidden>Only letters allowed</p>
                            </div>

                            <div class="field">
                                <label for="lastName">Last Name</label>
                                <input type="text"
                                       id="lastName"
                                       name="lastName"
                                       placeholder="Sithole"
                                       required
                                       pattern="^[A-Za-z]+$"
                                       title="Only letters allowed"
                                       aria-describedby="lastNameError"
                                       aria-invalid="false" />
                                <p class="error-text" id="lastNameError" aria-live="polite" hidden>Only letters allowed</p>
                            </div>
                        </div>
                    </section>

                    <section class="form-section">
                        <p class="section-label">Contact</p>
                        <div class="field">
                            <label for="email">Work Email</label>
                            <input type="email" id="email" name="email" placeholder="thabo@aacreations.co.za" required aria-describedby="emailError" aria-invalid="false" />
                            <p class="error-text" id="emailError" aria-live="polite" hidden>Enter a valid work email</p>
                        </div>

                        <div class="field">
                            <label for="phone">Mobile Number</label>
                            <div class="phone-row">
                                <span class="phone-prefix">+27</span>
                                <input type="tel"
                                       id="phone"
                                       name="phone"
                                       placeholder="723456789"
                                       required
                                       maxlength="9"
                                       aria-describedby="phoneError"
                                       aria-invalid="false" />
                            </div>
                            <p class="error-text" id="phoneError" aria-live="polite" hidden>Enter 9 digits and do not start with 0</p>
                        </div>
                    </section>

                    <section class="form-section">
                        <p class="section-label">Security</p>
                        <div class="grid-2">
                            <div class="field">
                                <label for="password">Password</label>
                                <div class="password-row">
                                    <input type="password"
                                           id="password"
                                           name="password"
                                           placeholder="••••••••"
                                           required
                                           aria-describedby="passwordError"
                                           aria-invalid="false" />
                                    <button type="button" class="toggle-pass" id="togglePass" aria-pressed="false">Show</button>
                                </div>
                                <p class="error-text" id="passwordError" aria-live="polite" hidden>
                                    Password must be at least 8 characters, include at least 2 uppercase letters and 1 special character.
                                </p>
                            </div>

                            <div class="field">
                                <label for="confirm">Confirm</label>
                                <input type="password" id="confirm" name="confirm" placeholder="••••••••" required aria-describedby="mismatchText" aria-invalid="false" />
                                <p class="error-text" id="mismatchText" aria-live="polite" hidden>Passwords do not match</p>
                            </div>
                        </div>
                    </section>

                    <div class="terms-box">
                        <label class="terms-label">
                            <input type="checkbox" id="termsAccepted" name="termsAccepted" required />
                            <span>I confirm that all information provided is accurate and I agree to the Admin Terms of Use.</span>
                        </label>
                    </div>

                    <div style="margin-top:18px;">
                        <button type="submit" class="submit-btn" id="submitBtn">Submit Admin Request</button>
                    </div>
                }

                <p class="footer-text">
                    Back to admin sign in page
                    @Html.ActionLink("Back to Admin Login", "Login", "Cust", new { area = "" }, new { @class = "footer-link" })
                </p>


                <!-- ============ SUCCESS STATE (hidden until form submit) ============ -->
                <div class="success-page" id="successPage" hidden>
                    <div class="success-content">
                        <div class="success-icon">
                            <svg width="80" height="80" viewBox="0 0 80 80">
                                <circle cx="40" cy="40" r="36" fill="#f9e6f0" stroke="#d4006a" stroke-width="2" />
                                <polyline points="28,42 38,52 54,32" fill="none" stroke="#d4006a" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                        </div>
                        <h2 class="success-title">Registration successful</h2>
                        <p class="success-message">
                            Welcome, <b id="successName"></b>. Registration successful.
                        </p>
                        <button class="success-btn" onclick="window.location.href='@Url.Action("Login", "Cust")'">Go to Sign</button>
                    </div>
                </div>

            </div>
        </main>

    </div>

    <script src="~/Scripts/Adminregister.js"></script>
</body>
</html>