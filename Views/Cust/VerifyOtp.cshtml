@{
    ViewBag.Title = "Verify OTP";
}
<link rel="stylesheet" href="~/Content/Manage Account styles.css" />

<div class="manage-account-page">

    <div class="account-card">

        <h2>Verify Your Identity</h2>

        <p>Enter the 6-digit verification code that was sent to you. Codes expire after five minutes and can only be used once.</p>

        @if (TempData["OtpNotice"] != null)
        {
            <div class="account-success">@TempData["OtpNotice"]</div>
        }
        @if (TempData["OtpError"] != null)
        {
            <div class="account-error">@TempData["OtpError"]</div>
        }

        @using (Html.BeginForm("VerifyOtp", "Cust", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <div class="account-field">

                <label for="otp">
                    Verification Code
                </label>

                <input type="text"
                       id="otp"
                       name="otp"
                       class="account-input"
                       maxlength="6"
                       inputmode="numeric"
                       autocomplete="one-time-code"
                       placeholder="Enter 6-digit code" />

            </div>

            @Html.ValidationSummary(
                true,
                "",
                new { @class = "account-error" }
            )

            <div class="account-actions">

                <button type="submit"
                        class="save-account-btn">
                    Verify Code
                </button>

            </div>
        }

    </div>

</div>