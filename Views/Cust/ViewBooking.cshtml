<html lang="en-ZA">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="View and manage AA Creations & Events bookings.">
    <title>My Bookings | AA Creations & Events</title>
    <link rel="stylesheet" href="~/Content/sstyle.css">
</head>
<body data-page="bookings">


    <main class="bookings-page">
        <div class="narrow">
            <div class="booking-head">
                <p class="eyebrow">Your Reservations</p>
                <h1>My Bookings</h1>
                <p>View and manage your upcoming celebration setups.</p>
            </div>

            <div class="filter-tabs" role="tablist" aria-label="Booking filters">
                <button class="filter-tab active" type="button" data-filter="upcoming">Upcoming</button>
                <button class="filter-tab" type="button" data-filter="all">All</button>
                <button class="filter-tab" type="button" data-filter="past">Past</button>
            </div>

            <p class="booking-count" id="bookingCount"></p>

            <div id="emptyState" class="empty-state" hidden>
                <div class="empty-icon">🎈</div>
                <h3 id="emptyTitle">No Upcoming Bookings</h3>
                <p id="emptyCopy">You haven't made any bookings yet. Book your first celebration setup!</p>
                <a href="~/Views/Cust/Booking.cshtml" class="btn btn-primary">Book a Setup</a>
            </div>

            <div class="booking-list" id="bookingList"></div>

            <div id="bookAnother" style="margin-top:40px;text-align:center;">
                <a href="@Url.Action("Booking", "Cust")" class="btn btn-gradient">+ Book Another Setup</a>
            </div>
        </div>
    </main>

    <script src="~/Scripts/Common.js"></script>

    <script src="~/Scripts/ViewBooking.js"></script>
</body>
</html>