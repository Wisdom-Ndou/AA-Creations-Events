@using System.Collections.Generic
@using System.Linq
@model IEnumerable<WebApplication1.Models.Booking>
@{
    var assignedBookingIds = ViewBag.AssignedBookingIds as List<int> ?? new List<int>();
}

<!DOCTYPE html>
<html lang="en-ZA">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="View and manage AA Creations & Events bookings.">
    <title>My Bookings | AA Creations & Events</title>

    <link rel="stylesheet" href="~/Content/sstyle.css">

    <style>
        /* Critical cancellation-popup styles kept here so the dialog never
           falls back into normal page flow if the external CSS is cached. */
        #cancelBookingModal {
            position: fixed;
            inset: 0;
            z-index: 9999;
            display: none;
            align-items: center;
            justify-content: center;
            padding: 24px;
            background: rgba(13, 0, 8, .76);
            backdrop-filter: blur(5px);
        }

        #cancelBookingModal.is-open {
            display: flex;
        }

        #cancelBookingModal .cancel-modal {
            position: relative;
            width: min(100%, 560px);
            max-height: calc(100vh - 48px);
            overflow-y: auto;
            padding: 30px;
            border: 1px solid #ead6e3;
            border-radius: 24px;
            background: #fffafd;
            box-shadow: 0 30px 90px rgba(44,0,22,.34);
        }

        #cancelBookingModal .cancel-modal-close {
            position: absolute;
            top: 16px;
            right: 18px;
            width: 34px;
            height: 34px;
            display: grid;
            place-items: center;
            border: 0;
            border-radius: 50%;
            color: #7a3a5c;
            background: #f6eaf0;
            font-size: 22px;
            cursor: pointer;
        }

        #cancelBookingModal .cancel-modal-close:hover {
            color: #fff;
            background: #c51562;
        }

        #cancelBookingModal .cancel-modal-icon {
            width: 48px;
            height: 48px;
            margin-bottom: 14px;
            display: grid;
            place-items: center;
            border-radius: 50%;
            color: #fff;
            background: linear-gradient(135deg,#c51562,#e91e8c);
            font-size: 22px;
            font-weight: 800;
        }

        #cancelBookingModal h2 {
            margin: 0 0 10px;
            color: #2c1622;
            font-size: 28px;
        }

        #cancelBookingModal .cancel-modal-copy {
            margin: 0 0 18px;
            color: #725d68;
            font-size: 14px;
            line-height: 1.65;
        }

        #cancelBookingModal .cancel-booking-summary {
            margin-bottom: 18px;
            padding: 14px 16px;
            border: 1px solid #ead6e3;
            border-radius: 14px;
            background: #fff2f7;
            color: #4a2036;
            font-size: 13px;
            line-height: 1.6;
        }

        #cancelBookingModal .cancel-reason-label {
            display: block;
            margin-bottom: 7px;
            color: #6f4057;
            font-size: 12px;
            font-weight: 700;
            letter-spacing: .08em;
            text-transform: uppercase;
        }

        #cancelBookingModal .cancel-reason-input {
            width: 100%;
            max-width: none;
            min-height: 130px;
            resize: vertical;
            box-sizing: border-box;
            padding: 14px 16px;
            border: 1px solid #dcb9ca;
            border-radius: 14px;
            outline: none;
            color: #2c1622;
            background: #fff;
            font: inherit;
            line-height: 1.55;
        }

        #cancelBookingModal .cancel-reason-input:focus {
            border-color: #c51562;
            box-shadow: 0 0 0 3px rgba(197,21,98,.12);
        }

        #cancelBookingModal .cancel-reason-input.invalid {
            border-color: #c73b54;
        }

        #cancelBookingModal .cancel-reason-footer {
            min-height: 20px;
            margin-top: 6px;
            display: flex;
            justify-content: space-between;
            gap: 12px;
            color: #9c7a89;
            font-size: 11px;
        }

        #cancelBookingModal .cancel-reason-error {
            color: #b22547;
            font-weight: 700;
        }

        #cancelBookingModal .cancel-modal-actions {
            margin-top: 22px;
            display: flex;
            justify-content: flex-end;
            gap: 10px;
        }

        #cancelBookingModal .cancel-confirm-btn {
            color: #fff;
            background: linear-gradient(135deg,#a81446,#d91e68);
        }

        body.cancel-modal-open {
            overflow: hidden;
        }

        @@media (max-width: 560px) {
            #cancelBookingModal {
                padding: 14px;
            }

            #cancelBookingModal .cancel-modal {
                padding: 24px 20px 20px;
            }

            #cancelBookingModal .cancel-modal-actions {
                flex-direction: column-reverse;
            }

            #cancelBookingModal .cancel-modal-actions .btn {
                width: 100%;
            }
        }
    </style>
</head>

<body data-page="bookings">

    <main class="bookings-page" id="bookingsApp"
          data-logged-in="@(Session["CustomerEmail"] != null ? "true" : "false")"
          data-complete-url="@Url.Action("CompleteCustomerBooking", "Cust")"
          data-cancel-url="@Url.Action("CancelCustomerBooking", "Cust")"
          data-pay-url="@Url.Action("PayBookingBalance", "Cust")">
        @Html.AntiForgeryToken()

        <!-- Login Overlay -->
        <div id="bookingsLoginOverlay" class="booking-login-overlay">

            <div class="booking-login-card">

                <div class="booking-login-icon">🔒</div>

                <p class="eyebrow">Sign In Required</p>

                <h2>Ready to view your bookings?</h2>

                <p>
                    Please sign in to your customer account before viewing your bookings.
                    Your bookings will be saved to your account so you can view them later.
                </p>

                <div class="booking-login-actions">

                    <a href="@Url.Action("Login", "Cust")"
                       class="btn btn-primary">
                        Sign In
                    </a>

                    <a href="@Url.Action("Customerregister", "Cust")"
                       class="btn btn-outline">
                        Create Account
                    </a>

                </div>

            </div>

        </div>

        <div class="narrow">

            <div class="booking-head">
                <p class="eyebrow">Your Reservations</p>
                <h1>My Bookings</h1>
                <p>View and manage your upcoming celebration setups.</p>
            </div>

            <div class="filter-tabs" role="tablist" aria-label="Booking filters">

                <button class="filter-tab active"
                        type="button"
                        data-filter="upcoming">
                    Upcoming
                </button>

                <button class="filter-tab"
                        type="button"
                        data-filter="all">
                    All
                </button>

                <button class="filter-tab"
                        type="button"
                        data-filter="past">
                    Past
                </button>

            </div>

            <p class="booking-count" id="bookingCount"></p>
            @if (TempData["PaymentSuccess"] != null)
            {
                <div style="margin:0 0 18px;padding:13px 16px;border:1px solid #b8dfc9;border-radius:12px;background:#f2fbf6;color:#21643e;font-size:14px;">
                    @TempData["PaymentSuccess"]
                </div>
            }

            @if (TempData["PaymentError"] != null)
            {
                <div style="margin:0 0 18px;padding:13px 16px;border:1px solid #efbfd2;border-radius:12px;background:#fff4f8;color:#9e1657;font-size:14px;">
                    @TempData["PaymentError"]
                </div>
            }


            <div id="emptyState" class="empty-state" hidden>

                <div class="empty-icon">🎈</div>

                <h3 id="emptyTitle">No Upcoming Bookings</h3>

                <p id="emptyCopy">
                    You haven't made any bookings yet.
                    Book your first celebration setup!
                </p>

                <a href="@Url.Action("Booking", "Cust")"
                   class="btn btn-primary">
                    Book a Setup
                </a>

            </div>

            <div class="booking-list" id="bookingList"></div>

            <div id="bookAnother"
                 style="margin-top:40px;text-align:center;">

                <a href="@Url.Action("Booking", "Cust")"
                   class="btn btn-gradient">
                    + Book Another Setup
                </a>

            </div>

        </div>
    </main>

    <div class="cancel-modal-backdrop" id="cancelBookingModal" aria-hidden="true">
        <div class="cancel-modal" role="dialog" aria-modal="true" aria-labelledby="cancelBookingTitle">
            <button type="button" class="cancel-modal-close" id="cancelModalClose" aria-label="Close cancellation dialog">×</button>

            <div class="cancel-modal-icon">!</div>
            <p class="eyebrow">Cancel Booking</p>
            <h2 id="cancelBookingTitle">Tell us why you're cancelling</h2>
            <p class="cancel-modal-copy">
                Your refund will be calculated from the amount you've already paid according to the cancellation policy.
            </p>

            <div class="cancel-booking-summary" id="cancelBookingSummary"></div>

            <label class="cancel-reason-label" for="cancelReason">Cancellation reason</label>
            <textarea id="cancelReason"
                      class="cancel-reason-input"
                      maxlength="500"
                      rows="5"
                      placeholder="Please tell us why you need to cancel this booking..."></textarea>

            <div class="cancel-reason-footer">
                <span id="cancelReasonError" class="cancel-reason-error" hidden>Please enter a reason before continuing.</span>
                <span id="cancelReasonCount">0 / 500</span>
            </div>

            <div class="cancel-modal-actions">
                <button type="button" class="btn btn-outline" id="cancelModalKeep">Keep Booking</button>
                <button type="button" class="btn cancel-confirm-btn" id="cancelModalConfirm">Confirm Cancellation</button>
            </div>
        </div>
    </div>

    <script>
        window.databaseBookings = @Html.Raw(
            Newtonsoft.Json.JsonConvert.SerializeObject(
                Model.Select(b => new
                {
                    id = b.BookingId,
                    firstName = b.FirstName,
                    lastName = b.LastName,
                    email = b.Email,
                    phone = b.Phone,
                    occasion = b.Occasion,
                    date = b.EventDate.ToString("yyyy-MM-dd"),
                    time = b.EventTime,
                    address = b.Address,
                    city = b.City,
                    notes = b.Notes,
                    packageId = b.PackageId,
                    packageName = b.Package != null ? b.Package.Name : "Unknown Package",
                    packagePrice = b.Package != null ? b.Package.Price : 0,
                    addOns = b.BookingAddOns.Select(ba => new
                    {
                        id = ba.AddOnId,
                        name = ba.AddOn != null ? ba.AddOn.Name : "Unknown Add-On",
                        price = ba.AddOn != null ? ba.AddOn.Price : 0
                    }),
                    totalPrice = b.TotalPrice,
                    amountPaid = b.AmountPaid,
                    balanceOutstanding = b.BalanceOutstanding,
                    paymentStatus = b.PaymentStatus,
                    balanceDueDate = b.BalanceDueDate,
                    cancellationCharge = b.CancellationCharge,
                    refundAmount = b.RefundAmount,
                    createdAt = b.CreatedAt,
                    status = b.Status,
                    staffAssigned = assignedBookingIds.Contains(b.BookingId)
                })
            )
        );
    </script>

    <script src="~/Scripts/Common.js"></script>
    <script src="~/Scripts/ViewBooking.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const app = document.getElementById("bookingsApp");
            const overlay = document.getElementById("bookingsLoginOverlay");

            if (!app || !overlay) return;

            const isLoggedIn = app.dataset.loggedIn === "true";

            if (!isLoggedIn) {
                overlay.classList.add("visible");
            }

        });
    </script>

</body>
</html>