@{
    ViewBag.Title = "Terms & Conditions";

    var currentTerms =
        ViewBag.CurrentTerms as WebApplication1.Models.TermsAndConditions;
}

<div class="aa-terms-page">
    <div class="aa-terms-container">

        <h1>Terms & Conditions</h1>

        @if (currentTerms != null)
        {
            <div class="aa-terms-version">
                <strong>Terms Version:</strong>
                @currentTerms.Version
                <br />

                <strong>Effective Date:</strong>
                @currentTerms.EffectiveDate.ToString("dd MMMM yyyy")
            </div>

            <div class="aa-terms-content">
                @Html.Raw(currentTerms.Content)
            </div>
        }
        else
        {
            <p>
                The Terms & Conditions are currently unavailable.
                Please try again later.
            </p>
        }

    </div>
</div>


