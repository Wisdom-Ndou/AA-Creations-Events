<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - My ASP.NET Application</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
</head>
<body>

        <nav class="desktop-nav" aria-label="Main navigation">
            <!--- You should probably remove Services & Portfllio buttons as they are alrwady prsent bellow/-->
            <a href="@Url.Action("Index", "Cust")" class="logo">AA Creations & Events</a>
            <ul class="nav-links">
                <li><a href="@Url.Action("Portfolio", "Cust")">PORTFOLIO</a></li>
                <li><a href="@Url.Action("Booking", "Cust")">MAKE A BOOKING</a></li>
                <li><a href="@Url.Action("ViewBooking", "Cust")">VIEW BOOKING</a></li>
                <li><a href="#">CONTACT US</a></li>
                <li><a href="@Url.Action("Login", "Cust")">LOGIN</a></li>

            </ul>
            <div class="nav-icons">
                <div>
                    <a href="https://shorturl.at/hRi2x" target="_blank"> 🎵 TikTok</a> |
                    <a href="https://wa.me/27123456789" target="_blank">💬 WhatsApp</a> |
                    <a href="https://www.instagram.com/aacreation.events?igsi=d2d5OGxkZnFxcDIy&utm_source=qr" target="_blank">📸 Instagram</a>
                </div>
            </div>
        </nav>
    <div class="container body-content">
        @RenderBody()
        <hr />
        <footer>
            <p class="quote">"Every celebration deserves to be unforgettable."</p>
            <p>&copy; @DateTime.Now.Year - AA Creations &amp; Events.  All rights reserved.</p>
            <p class="footer-contact">Contact: 073 123 2660 / 069 843 2686</p>

        </footer>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
    <script type="module" src="~/Scripts/firebase-config.js"></script>
</body>
</html>
