<?xml version="1.0"?>

<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <system.web>
    <compilation debug="false"
                 xdt:Transform="SetAttributes(debug)" />

    <!-- Never expose detailed ASP.NET exceptions to remote production users. -->
    <customErrors mode="On"
                  xdt:Transform="Insert" />

    <!-- Production is HTTPS-only in Azure, so authentication/session-related
         cookies must never travel over plaintext HTTP. -->
    <httpCookies httpOnlyCookies="true"
                 requireSSL="true"
                 sameSite="Lax"
                 xdt:Transform="Insert" />

    <sessionState cookieless="UseCookies"
                  cookieSameSite="Lax"
                  xdt:Transform="Insert" />

    <httpRuntime enableVersionHeader="false"
                 xdt:Transform="SetAttributes(enableVersionHeader)" />
  </system.web>

  <system.webServer xdt:Transform="Insert">
    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
      </customHeaders>
    </httpProtocol>

    <security>
      <requestFiltering removeServerHeader="true" />
    </security>
  </system.webServer>
</configuration>
